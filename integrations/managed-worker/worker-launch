#!/usr/bin/env python3
"""Immutable image entrypoint. Never read authentication; exec Codex with reviewed settings."""
import hashlib
import json
import os
import sys
from pathlib import Path


def main():
    runtime = Path('/opt/dependencies/runtime')
    if runtime.is_dir():
        fallback = Path('/worker/home/.cache/codex-runtimes/codex-primary-runtime')
        fallback.mkdir(parents=True, exist_ok=True)
        (fallback / 'dependencies').symlink_to(runtime)
    binary_digest, config_digest, binary, *arguments = sys.argv[1:]
    config = Path('/opt/aeep/worker-config.json')
    if hashlib.sha256(config.read_bytes()).hexdigest() != config_digest:
        raise SystemExit('worker configuration digest mismatch')
    with Path(binary).open('rb') as stream:
        if hashlib.file_digest(stream, 'sha256').hexdigest() != binary_digest:
            raise SystemExit('worker binary digest mismatch')
    overrides = json.loads(config.read_text())
    files = json.loads(os.environ.pop('AEEP_REVIEWED_FILES', '{}'))
    if not isinstance(files, dict) or len(files) > 2000:
        raise SystemExit('invalid reviewed worker files')
    for name, digest in files.items():
        path = Path(name)
        if (not path.is_relative_to('/opt') or '..' in path.parts
                or any(parent.is_symlink() for parent in (path, *path.parents))
                or not path.is_file() or path.stat().st_size > 10_000_000
                or hashlib.sha256(path.read_bytes()).hexdigest() != digest):
            raise SystemExit('reviewed worker file mismatch')
    if not isinstance(overrides, list) or not all(isinstance(item, str) and '\x00' not in item for item in overrides):
        raise SystemExit('invalid reviewed worker configuration')
    schema = os.environ.pop("AEEP_OUTPUT_SCHEMA", None)
    if schema is not None:
        Path("/tmp/aeep-output.schema.json").write_text(schema)
    argv = [binary]
    for override in overrides:
        argv += ['-c', override]
    if arguments and arguments[0].startswith('--aeep-catalog-metrics='):
        scope = arguments.pop(0).split('=', 1)[1]
        if not arguments or arguments[0] != 'app-server' or '/opt/aeep/codex_metrics.py' not in files:
            raise SystemExit('catalog metrics require a reviewed App Server collector')
        from codex_metrics import relay
        try:
            code = relay([*argv, *arguments], scope)
        except Exception:
            raise SystemExit('catalog metrics relay failed') from None
        raise SystemExit(code)
    os.execv(binary, [*argv, *arguments])


if __name__ == '__main__':
    main()
