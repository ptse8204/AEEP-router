{
  "config": {
    "default": true,
    // References and evidence tables contain long identifiers and URLs.
    "MD013": false,
    "MD024": { "siblings_only": true },
    // Explicit anchors preserve published links when sections move.
    "MD033": { "allowed_elements": ["a", "br", "details", "summary"] },
    // Existing table spacing is readable and need not be realigned.
    "MD060": false
  }
}
