      "task_id": "aeep-cli-override-placement",
      "task": "Repair global configuration option placement: append telemetry -c overrides after existing global options, before app-server when present. Preserve all argv elements and override order. Support commands with no app-server.",
      "family": "regression-repair",
      "files": {
        "launch.py": "def command(argv, options):\n    return [*argv, *(part for option in options for part in ('-c', option))]\n",
        "README.txt": "Extracted CLI argv construction; no process launching or network.\n"
      },
      "editable_paths": [
        "launch.py"
      ]
    },
    "truth": {
