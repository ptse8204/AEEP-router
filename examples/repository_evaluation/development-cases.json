      "task_id": "aeep-token-unknown-propagation",
      "task": "Preserve the token_total contract through the public total API: unavailable counts must remain None; measured zero must remain zero. Do not double count included token categories. Preserve the core accounting implementation.",
      "family": "contract-propagation",
      "files": {
        "counts.py": "from __future__ import annotations\ndef token_total(tokens: TokenObservation | None) -> int | None:\n    if tokens is None or tokens.input_tokens is None or tokens.output_tokens is None:\n        return None\n    total = tokens.input_tokens + tokens.output_tokens\n    for count, semantics in ((tokens.cached_input_tokens, tokens.cached_semantics),\n                             (tokens.reasoning_output_tokens, tokens.reasoning_semantics)):\n        if semantics == \"unknown\" or (semantics == \"separate\" and count is None):\n            return None\n        if semantics == \"separate\" and count is not None:\n            total += count\n    return total\n",
        "api.py": "from types import SimpleNamespace\nimport counts\ndef total(value):\n    return counts.token_total(None if value is None else SimpleNamespace(**value)) or 0\n"
      },
      "editable_paths": [
        "api.py"
      ]
    },
