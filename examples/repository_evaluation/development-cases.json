      "task_id": "aeep-callback-binding-audit",
      "task": "Audit grader_name: it must bind both the input and expected result with the canonical content digest. Preserve working behavior; make no change if this contract is already met.",
      "family": "adjacent-no-change",
      "files": {
        "callbacks.py": "from __future__ import annotations\nfrom digest import content_digest\ndef grader_name(value: dict[str, Any], expected: dict[str, Any]) -> str:\n    return \"contained_recipe_\" + content_digest({\"input\": value, \"expected\": expected})\n",
        "digest.py": "import hashlib, json\ndef content_digest(value):\n    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(\",\", \":\"), allow_nan=False).encode()).hexdigest()\n"
      },
