        "launch.py": "def command(argv, options):\n    boundary = argv.index('app-server') if 'app-server' in argv else len(argv)\n    return [*argv[:boundary], *(part for option in options for part in ('-c', option)), *argv[boundary:]]\n"
      }
    },
