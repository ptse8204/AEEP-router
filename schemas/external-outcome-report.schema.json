{
  "$defs": {
    "ExecutionStatus": {
      "enum": [
        "success",
        "failed",
        "timeout",
        "rejected",
        "host_selected",
        "delegated",
        "unknown"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "QuotaSource": {
      "enum": [
        "user",
        "host",
        "official_cli",
        "rate_limit",
        "heuristic",
        "observed"
      ],
      "title": "QuotaSource",
      "type": "string"
    },
    "QuotaState": {
      "description": "Private opportunity-cost signal for a non-transferable subscription.",
      "enum": [
        "abundant",
        "normal",
        "tight",
        "critical",
        "exhausted",
        "unknown"
      ],
      "title": "QuotaState",
      "type": "string"
    },
    "ResourceVector": {
      "additionalProperties": false,
      "description": "Raw resource dimensions for one attempt.\n\n`memory_mb_seconds` is the integral of route-attributable resident memory\nover time. `peak_memory_mb` is retained separately because it is useful as a\nhard capacity constraint rather than only a consumable-resource signal.",
      "properties": {
        "monetary_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Monetary Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cpu Ms",
          "type": "number"
        },
        "memory_mb_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Memory Mb Seconds",
          "type": "number"
        },
        "peak_memory_mb": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Peak Memory Mb",
          "type": "number"
        },
        "gpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Gpu Ms",
          "type": "number"
        },
        "network_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Network Bytes",
          "type": "integer"
        },
        "context_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "subscription_units": {
          "default": 0.0,
          "description": "Provider-local capacity units; not cash and not transferable.",
          "minimum": 0.0,
          "title": "Subscription Units",
          "type": "number"
        }
      },
      "title": "ResourceVector",
      "type": "object"
    },
    "SubscriptionQuota": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/QuotaState",
          "default": "unknown"
        },
        "reset_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reset At"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/QuotaSource",
          "default": "user"
        }
      },
      "title": "SubscriptionQuota",
      "type": "object"
    },
    "TrustLevel": {
      "enum": [
        "untrusted",
        "self_asserted",
        "observed",
        "verified",
        "attested"
      ],
      "title": "TrustLevel",
      "type": "string"
    },
    "ValidationKind": {
      "enum": [
        "schema",
        "exact_match",
        "range",
        "state_transition",
        "callback",
        "downstream",
        "llm",
        "human"
      ],
      "title": "ValidationKind",
      "type": "string"
    },
    "ValidationResult": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ValidationKind"
        },
        "valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid"
        },
        "quality_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Score"
        },
        "detail": {
          "default": "",
          "maxLength": 4096,
          "title": "Detail",
          "type": "string"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "observed"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ValidationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "executor_id": {
      "title": "Executor Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "actual_resources": {
      "$ref": "#/$defs/ResourceVector"
    },
    "output_valid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Valid"
    },
    "task_valid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Valid"
    },
    "quality_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality Score"
    },
    "validation_results": {
      "items": {
        "$ref": "#/$defs/ValidationResult"
      },
      "title": "Validation Results",
      "type": "array"
    },
    "quota_observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubscriptionQuota"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error_message": {
      "anyOf": [
        {
          "maxLength": 16384,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    }
  },
  "required": [
    "decision_id",
    "executor_id",
    "status"
  ],
  "title": "ExternalOutcomeReport",
  "type": "object"
}
