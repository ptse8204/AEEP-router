              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Intake Id"
          },
          "request": {
            "anyOf": [
              {
                "$ref": "#/$defs/ActionRequest"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "candidate_id"
        ],
        "title": "AdmissionLookupRequest",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    }
  ]
