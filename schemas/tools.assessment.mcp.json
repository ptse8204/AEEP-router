{
  "tools": [
    {
      "name": "aeep_assessment_options",
      "description": "List existing operator-selected subjects, recipes, environments and configured routes under a current grant. Does not inspect files or approve execution.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "authorization_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "after": {
            "type": "string",
            "maxLength": 400
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "authorization_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aeep_assessment_setup",
      "description": "Prepare a reviewed-recipe assessment using existing configuration and grant scope. Returns missing review requirements, fixture-generation instructions or a proposed plan; never approves definitions or starts trials.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "Select configured definitions; no paths, executable code or approval fields.",
        "properties": {
          "schema_version": {
            "const": "assessment.setup.v1",
            "default": "assessment.setup.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "authorization_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Authorization Id",
            "type": "string"
          },
          "subject_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Subject Id",
            "type": "string"
          },
          "recipe_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Recipe Id",
            "type": "string"
          },
          "environment_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Environment Id",
            "type": "string"
          },
          "candidate_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Candidate Id",
            "type": "string"
          },
          "baseline_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Baseline Id",
            "type": "string"
          },
          "structure": {
            "anyOf": [
              {
                "enum": [
                  "direct",
                  "controlled_agent",
                  "workflow"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Structure"
          },
          "seed": {
            "default": 0,
            "maximum": 2147483647,
            "minimum": 0,
            "title": "Seed",
            "type": "integer"
          },
          "case_set_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Case Set Id"
          },
          "experiment_id": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Experiment Id"
          },
          "pilot_report_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pilot Report Id"
          }
        },
        "required": [
          "authorization_id",
          "subject_id",
          "recipe_id",
          "environment_id",
          "candidate_id",
          "baseline_id"
        ],
        "title": "AssessmentSetupRequest",
        "type": "object"
      }
    },
    {
      "name": "aeep_assessment_generate_cases",
      "description": "Generate synthetic fixtures for an existing, operator-reviewed materialization request under its original grant. Cannot approve a recipe, expand limits or replay execution.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "materialization_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "materialization_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aeep_csv",
      "description": "CSV to string-valued records with strict row widths and unique headers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100000
          },
          "delimiter": {
            "enum": [
              ",",
              ";",
              "\t"
            ]
          }
        },
        "required": [
          "text",
          "delimiter"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "properties": {
              "records": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "records"
            ],
            "additionalProperties": false
          },
          {
            "properties": {
              "error": {
                "const": "invalid_input"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "aeep_text",
      "description": "Extract exact labeled fields; omit absent fields and reject duplicate requested labels.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100000
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "text",
          "fields"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "properties": {
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "fields"
            ],
            "additionalProperties": false
          },
          {
            "properties": {
              "error": {
                "const": "invalid_input"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "aeep_search",
      "description": "Find literal matches in UTF-8 files beneath an approved root, returning sorted paths and line numbers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string"
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "root",
          "query",
          "path"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "properties": {
              "matches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "line",
                    "text"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "matches"
            ],
            "additionalProperties": false
          },
          {
            "properties": {
              "error": {
                "const": "invalid_input"
              }
            },
            "required": [
              "error"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "aeep_assessment_start",
      "description": "Start an assessment under an existing reviewed plan and operator authorization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "plan_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aeep_assessment_status",
      "description": "Status an assessment under an existing reviewed plan and operator authorization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "assessment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "assessment_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aeep_assessment_report",
      "description": "Report an assessment under an existing reviewed plan and operator authorization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "assessment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "assessment_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aeep_assessment_cancel",
      "description": "Cancel an assessment under an existing reviewed plan and operator authorization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "assessment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "assessment_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aeep_assessment_generate_definition",
      "description": "Generate_definition an assessment under an existing reviewed plan and operator authorization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "planning_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "planning_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aeep_assessment_structures",
      "description": "Structures an assessment under an existing reviewed plan and operator authorization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "plan_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aeep_assessment_select_structure",
      "description": "Select_structure an assessment under an existing reviewed plan and operator authorization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "structure": {
            "enum": [
              "direct",
              "controlled_agent",
              "workflow"
            ]
          }
        },
        "required": [
          "plan_id",
          "structure"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aeep_assessment_budget",
      "description": "Budget an assessment under an existing reviewed plan and operator authorization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "plan_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aeep_discover_resources",
      "description": "Search operator-configured sources using public terms only. Returns inert untrusted metadata; never installs, qualifies, activates or assesses a resource.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "discovery.request.v1",
            "default": "discovery.request.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "public_query": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Public Query",
            "type": "string"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Source Ids",
            "type": "array"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "artifact_types": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "title": "Artifact Types",
            "type": "array"
          }
        },
        "required": [
          "public_query",
          "source_ids"
        ],
        "title": "DiscoveryRequest",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": false
      }
    },
    {
      "name": "aeep_lookup_capability",
      "description": "Look up local, scoped evidence for an inspected candidate. Returns an applicable admission or a reason to assess or keep the current environment. Never starts an assessment or grants authority; dispatch rechecks applicability.",
      "inputSchema": {
        "$defs": {
          "ActionConstraints": {
            "additionalProperties": false,
            "properties": {
              "max_cost_usd": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Cost Usd"
              },
              "max_latency_ms": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Latency Ms"
              },
              "max_cpu_ms": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Cpu Ms"
              },
              "max_memory_mb_seconds": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Memory Mb Seconds"
              },
              "max_peak_memory_mb": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Peak Memory Mb"
              },
              "max_gpu_ms": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Gpu Ms"
              },
              "max_network_bytes": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Network Bytes"
              },
              "max_context_tokens": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Context Tokens"
              },
              "min_success_probability": {
                "default": 0.7,
                "maximum": 1.0,
                "minimum": 0.0,
                "title": "Min Success Probability",
                "type": "number"
              },
              "min_quality_score": {
                "default": 0.5,
                "maximum": 1.0,
                "minimum": 0.0,
                "title": "Min Quality Score",
                "type": "number"
              },
              "max_risk_score": {
                "default": 0.5,
                "maximum": 1.0,
                "minimum": 0.0,
                "title": "Max Risk Score",
                "type": "number"
              },
              "max_side_effect": {
                "$ref": "#/$defs/SideEffect",
                "default": "read"
              },
              "allow_network": {
                "default": true,
                "title": "Allow Network",
                "type": "boolean"
              },
              "require_local": {
                "default": false,
                "title": "Require Local",
                "type": "boolean"
              },
              "allowed_executor_kinds": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/ExecutorKind"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Allowed Executor Kinds"
              },
              "allowed_executor_ids": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Allowed Executor Ids"
              },
              "denied_executor_ids": {
                "items": {
                  "type": "string"
                },
                "title": "Denied Executor Ids",
                "type": "array"
              },
              "allowed_data_residency": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Allowed Data Residency"
              }
            },
            "title": "ActionConstraints",
            "type": "object"
          },
          "ActionContext": {
            "additionalProperties": false,
            "properties": {
              "data_sensitivity": {
                "$ref": "#/$defs/DataSensitivity",
                "default": "internal"
              },
              "state_locality": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Locality"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "preferred_region": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Preferred Region"
              },
              "compute": {
                "$ref": "#/$defs/ComputeAvailability"
              },
              "labels": {
                "additionalProperties": {
                  "type": "string"
                },
                "title": "Labels",
                "type": "object"
              },
              "traceparent": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Traceparent"
              },
              "subscription_quotas": {
                "additionalProperties": {
                  "$ref": "#/$defs/SubscriptionQuota"
                },
                "title": "Subscription Quotas",
                "type": "object"
              },
              "cache_affinity": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/CacheRoutingContext"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "title": "ActionContext",
            "type": "object"
          },
          "ActionRequest": {
            "additionalProperties": false,
            "properties": {
              "action_id": {
                "title": "Action Id",
                "type": "string"
              },
              "capability": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Capability",
                "type": "string"
              },
              "input": {
                "additionalProperties": true,
                "title": "Input",
                "type": "object"
              },
              "policy": {
                "default": "balanced",
                "title": "Policy",
                "type": "string"
              },
              "constraints": {
                "$ref": "#/$defs/ActionConstraints"
              },
              "context": {
                "$ref": "#/$defs/ActionContext"
              },
              "idempotency_key": {
                "anyOf": [
                  {
                    "maxLength": 256,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Idempotency Key"
              }
            },
            "required": [
              "capability"
            ],
            "title": "ActionRequest",
            "type": "object"
          },
          "CacheRoutingContext": {
            "additionalProperties": false,
            "properties": {
              "cache_scope_key_hmac": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Cache Scope Key Hmac",
                "type": "string"
              },
              "provider": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Provider",
                "type": "string"
              },
              "model": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Model",
                "type": "string"
              },
              "integration_adapter": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Integration Adapter",
                "type": "string"
              },
              "route_id": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Route Id",
                "type": "string"
              },
              "stable_prefix_digest_hmac": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Stable Prefix Digest Hmac",
                "type": "string"
              },
              "previous_state_digest_hmac": {
                "anyOf": [
                  {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Previous State Digest Hmac"
              },
              "common_prefix_tokens_estimate": {
                "default": 0,
                "minimum": 0,
                "title": "Common Prefix Tokens Estimate",
                "type": "integer"
              },
              "eligible_cached_tokens_estimate": {
                "default": 0,
                "minimum": 0,
                "title": "Eligible Cached Tokens Estimate",
                "type": "integer"
              },
              "recent_cache_read_tokens": {
                "default": 0,
                "minimum": 0,
                "title": "Recent Cache Read Tokens",
                "type": "integer"
              },
              "recent_cache_write_tokens": {
                "default": 0,
                "minimum": 0,
                "title": "Recent Cache Write Tokens",
                "type": "integer"
              },
              "recent_cache_miss_tokens": {
                "default": 0,
                "minimum": 0,
                "title": "Recent Cache Miss Tokens",
                "type": "integer"
              },
              "observed_hits": {
                "default": 0,
                "minimum": 0,
                "title": "Observed Hits",
                "type": "integer"
              },
              "observed_attempts": {
                "default": 0,
                "minimum": 0,
                "title": "Observed Attempts",
                "type": "integer"
              },
              "last_seen_at": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Last Seen At"
              },
              "compaction_generation": {
                "default": 0,
                "minimum": 0,
                "title": "Compaction Generation",
                "type": "integer"
              },
              "context_reset_reason": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Context Reset Reason"
              }
            },
            "required": [
              "cache_scope_key_hmac",
              "provider",
              "model",
              "integration_adapter",
              "route_id",
              "stable_prefix_digest_hmac"
            ],
            "title": "CacheRoutingContext",
            "type": "object"
          },
          "ComputeAvailability": {
            "additionalProperties": false,
            "description": "Resources available to the caller at routing time.\n\nThese values are optional because agents often know context-window or quota\nheadroom that the local process cannot detect.",
            "properties": {
              "available_memory_mb": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Available Memory Mb"
              },
              "available_cpu_fraction": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0.0,
                    "maximum": 1.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Available Cpu Fraction"
              },
              "available_gpu_ms": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Available Gpu Ms"
              },
              "context_tokens_remaining": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Context Tokens Remaining"
              },
              "monetary_budget_remaining_usd": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Monetary Budget Remaining Usd"
              },
              "network_metered": {
                "default": false,
                "title": "Network Metered",
                "type": "boolean"
              }
            },
            "title": "ComputeAvailability",
            "type": "object"
          },
          "DataSensitivity": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ],
            "title": "DataSensitivity",
