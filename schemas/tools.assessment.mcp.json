            "title": "ExecutorKind",
            "type": "string"
          },
          "Locality": {
            "enum": [
              "in_process",
              "local",
              "lan",
              "internet"
            ],
            "title": "Locality",
            "type": "string"
          },
          "QuotaSource": {
            "enum": [
              "user",
              "host",
              "official_cli",
              "rate_limit",
              "heuristic",
              "observed"
            ],
            "title": "QuotaSource",
            "type": "string"
          },
          "QuotaState": {
            "description": "Private opportunity-cost signal for a non-transferable subscription.",
            "enum": [
              "abundant",
              "normal",
              "tight",
              "critical",
              "exhausted",
              "unknown"
            ],
            "title": "QuotaState",
            "type": "string"
          },
          "SideEffect": {
            "enum": [
              "none",
              "read",
              "write",
              "destructive",
              "financial"
            ],
            "title": "SideEffect",
            "type": "string"
          },
          "SubscriptionQuota": {
            "additionalProperties": false,
            "properties": {
              "state": {
                "$ref": "#/$defs/QuotaState",
                "default": "unknown"
              },
              "reset_at": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Reset At"
              },
              "observed_at": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Observed At"
              },
              "confidence": {
                "default": 0.5,
                "maximum": 1.0,
                "minimum": 0.0,
                "title": "Confidence",
                "type": "number"
              },
              "source": {
                "$ref": "#/$defs/QuotaSource",
                "default": "user"
              },
              "unit": {
                "default": "provider_unit",
                "maxLength": 100,
                "minLength": 1,
                "title": "Unit",
                "type": "string"
              },
              "allowance_units": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Allowance Units"
              },
              "remaining_units": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Remaining Units"
              },
              "used_percent": {
                "anyOf": [
                  {
                    "maximum": 100.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Used Percent"
              },
              "window_duration_seconds": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Window Duration Seconds"
              },
              "window_count": {
                "default": 1,
                "minimum": 1,
                "title": "Window Count",
                "type": "integer"
              },
              "evidence_digest": {
                "anyOf": [
                  {
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Evidence Digest"
              }
            },
            "title": "SubscriptionQuota",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "maxLength": 300,
            "minLength": 1,
