{
  "$defs": {
    "EvidenceSource": {
      "enum": [
        "billing_record",
        "local_meter",
        "priced_measured_billable_usage",
        "confirmed_no_incremental_charge",
        "provider_report",
        "pinned_rate_table",
        "operator_report",
        "static_estimate",
        "legacy_unspecified",
        "unavailable"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "complete",
        "partial",
        "conflict",
        "unavailable"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "MeasurementEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unavailable"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource",
          "default": "unavailable"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "untrusted"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "source_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[A-Fa-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        }
      },
      "title": "MeasurementEvidence",
      "type": "object"
    },
    "SubscriptionCharge": {
      "enum": [
        "included",
        "paid",
        "mixed",
        "unknown"
      ],
      "title": "SubscriptionCharge",
      "type": "string"
    },
    "SubscriptionUsage": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "resource_pool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Resource Pool",
          "type": "string"
        },
        "unit": {
          "default": "provider_unit",
          "maxLength": 100,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "consumed": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumed"
        },
        "source": {
          "$ref": "#/$defs/MeasurementEvidence"
        },
        "included_or_paid": {
          "$ref": "#/$defs/SubscriptionCharge",
          "default": "unknown"
        },
        "rate_snapshot_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Snapshot Id"
        },
        "usage_fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Fingerprint"
        }
      },
      "required": [
        "provider",
        "resource_pool"
      ],
      "title": "SubscriptionUsage",
      "type": "object"
    },
    "TrustLevel": {
      "enum": [
        "untrusted",
        "self_asserted",
        "observed",
        "verified",
        "attested"
      ],
      "title": "TrustLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "default": 0,
      "title": "Decisions",
      "type": "integer"
    },
    "successful_actions": {
      "default": 0,
      "title": "Successful Actions",
      "type": "integer"
    },
    "failed_actions": {
      "default": 0,
      "title": "Failed Actions",
      "type": "integer"
    },
    "model_actions_avoided": {
      "default": 0,
      "title": "Model Actions Avoided",
      "type": "integer"
    },
    "model_turns_avoided": {
      "default": 0,
      "title": "Model Turns Avoided",
      "type": "integer"
    },
    "context_tokens_avoided": {
      "default": 0,
      "title": "Context Tokens Avoided",
      "type": "integer"
    },
    "subscription_capacity_conserved": {
      "default": 0.0,
      "title": "Subscription Capacity Conserved",
      "type": "number"
    },
    "local_cpu_ms_consumed": {
      "default": 0.0,
      "title": "Local Cpu Ms Consumed",
      "type": "number"
    },
    "api_money_spent_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Money Spent Usd"
    },
    "wall_clock_time_saved_ms": {
      "default": 0.0,
      "title": "Wall Clock Time Saved Ms",
      "type": "number"
    },
    "browser_actions_avoided": {
      "default": 0,
      "title": "Browser Actions Avoided",
      "type": "integer"
    },
    "mcp_calls_avoided": {
      "default": 0,
      "title": "Mcp Calls Avoided",
      "type": "integer"
    },
    "cli_substitutions": {
      "default": 0,
      "title": "Cli Substitutions",
      "type": "integer"
    },
    "total_money_spent_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Money Spent Usd"
    },
    "cost_per_successful_action_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Per Successful Action Usd"
    },
    "actual_cash_known_subtotal_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Actual Cash Known Subtotal Usd"
    },
    "actual_cash_total_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Cash Total Usd"
    },
    "cash_status": {
      "$ref": "#/$defs/EvidenceStatus",
      "default": "unavailable"
    },
    "subscription_usage": {
      "items": {
        "$ref": "#/$defs/SubscriptionUsage"
      },
      "title": "Subscription Usage",
      "type": "array"
    }
  },
  "title": "EconomicMetrics",
  "type": "object"
}
