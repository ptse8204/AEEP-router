          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "default_path": {
          "title": "Default Path",
          "type": "boolean"
        },
        "provider_calls": {
          "minimum": 0,
          "title": "Provider Calls",
          "type": "integer"
        },
        "model_turn_count": {
          "minimum": 0,
          "title": "Model Turn Count",
          "type": "integer"
        },
        "routing_model_rounds": {
          "minimum": 0,
          "title": "Routing Model Rounds",
          "type": "integer"
        },
        "tool_selection_rounds": {
          "minimum": 0,
          "title": "Tool Selection Rounds",
          "type": "integer"
        },
        "implementation_schema_bytes": {
          "minimum": 0,
          "title": "Implementation Schema Bytes",
          "type": "integer"
        },
        "result_bytes": {
          "minimum": 0,
          "title": "Result Bytes",
          "type": "integer"
        },
        "test_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Test Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "passed",
        "default_path",
        "provider_calls",
        "model_turn_count",
        "routing_model_rounds",
        "tool_selection_rounds",
        "implementation_schema_bytes",
        "result_bytes",
        "test_ids"
