{
  "$defs": {
    "SignatureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "hmac-sha256",
          "default": "hmac-sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "value": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "value"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_id": {
      "title": "Acceptance Id",
      "type": "string"
    },
    "quote_id": {
      "title": "Quote Id",
      "type": "string"
    },
    "action_id": {
      "title": "Action Id",
      "type": "string"
    },
    "accepted_amount_usd": {
      "minimum": 0.0,
      "title": "Accepted Amount Usd",
      "type": "number"
    },
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignatureEnvelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "quote_id",
    "action_id",
    "accepted_amount_usd"
  ],
  "title": "QuoteAcceptance",
  "type": "object"
}
