{
  "$defs": {
    "EstimateSource": {
      "enum": [
        "static",
        "historical",
        "blended",
        "quote",
        "observed"
      ],
      "title": "EstimateSource",
      "type": "string"
    },
    "ResourceVector": {
      "additionalProperties": false,
      "description": "Raw resource dimensions for one attempt.\n\n`memory_mb_seconds` is the integral of route-attributable resident memory\nover time. `peak_memory_mb` is retained separately because it is useful as a\nhard capacity constraint rather than only a consumable-resource signal.",
      "properties": {
        "monetary_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Monetary Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cpu Ms",
          "type": "number"
        },
        "memory_mb_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Memory Mb Seconds",
          "type": "number"
        },
        "peak_memory_mb": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Peak Memory Mb",
          "type": "number"
        },
        "gpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Gpu Ms",
          "type": "number"
        },
        "network_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Network Bytes",
          "type": "integer"
        },
        "context_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "subscription_units": {
          "default": 0.0,
          "description": "Provider-local capacity units; not cash and not transferable.",
          "minimum": 0.0,
          "title": "Subscription Units",
          "type": "number"
        }
      },
      "title": "ResourceVector",
      "type": "object"
    },
    "RouteEstimate": {
      "additionalProperties": false,
      "properties": {
        "resources": {
          "$ref": "#/$defs/ResourceVector"
        },
        "success_probability": {
          "default": 0.95,
          "maximum": 1.0,
          "minimum": 0.001,
          "title": "Success Probability",
          "type": "number"
        },
        "quality_score": {
          "default": 0.95,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality Score",
          "type": "number"
        },
        "risk_score": {
          "default": 0.05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/EstimateSource",
          "default": "static"
        },
        "sample_size": {
          "default": 0,
          "minimum": 0,
          "title": "Sample Size",
          "type": "integer"
        }
      },
      "title": "RouteEstimate",
      "type": "object"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "hmac-sha256",
          "default": "hmac-sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "value": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "value"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "quote_id": {
      "title": "Quote Id",
      "type": "string"
    },
    "quote_request_id": {
      "title": "Quote Request Id",
      "type": "string"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "executor_id": {
      "title": "Executor Id",
      "type": "string"
    },
    "capability": {
      "title": "Capability",
      "type": "string"
    },
    "monetary_usd": {
      "minimum": 0.0,
      "title": "Monetary Usd",
      "type": "number"
    },
    "estimate": {
      "$ref": "#/$defs/RouteEstimate"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "terms": {
      "additionalProperties": true,
      "title": "Terms",
      "type": "object"
    },
    "signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignatureEnvelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "quote_request_id",
    "provider_id",
    "executor_id",
    "capability",
    "monetary_usd",
    "estimate",
    "expires_at"
  ],
  "title": "Quote",
  "type": "object"
}
