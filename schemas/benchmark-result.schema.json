{
  "$defs": {
    "BenchmarkEntry": {
      "additionalProperties": false,
      "properties": {
        "executor_id": {
          "title": "Executor Id",
          "type": "string"
        },
        "executor_kind": {
          "$ref": "#/$defs/ExecutorKind"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Id"
        },
        "receipt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Id"
        },
        "ok": {
          "default": false,
          "title": "Ok",
          "type": "boolean"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimated": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_resources": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceVector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "accounting": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceAccounting"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "counterfactual_costs": {
          "items": {
            "$ref": "#/$defs/CounterfactualCashCost"
          },
          "title": "Counterfactual Costs",
          "type": "array"
        },
        "policy_valuations": {
          "items": {
            "$ref": "#/$defs/PolicyValuation"
          },
          "title": "Policy Valuations",
          "type": "array"
        },
        "output_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Valid"
        },
        "actual_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreBreakdown"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Rank"
        },
        "skipped_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped Reason"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        }
      },
      "required": [
        "executor_id",
        "executor_kind"
      ],
      "title": "BenchmarkEntry",
      "type": "object"
    },
    "CashAccounting": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unavailable"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/CashEvidence"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "title": "CashAccounting",
      "type": "object"
    },
    "CashClassification": {
      "enum": [
        "verified",
        "billing_reconciled",
        "pinned_rate_billable_usage",
        "estimated",
        "unavailable"
      ],
      "title": "CashClassification",
      "type": "string"
    },
    "CashEstimate": {
      "additionalProperties": false,
      "properties": {
        "amount_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Usd"
        },
        "upper_bound_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound Usd"
        },
        "evidence": {
          "$ref": "#/$defs/MeasurementEvidence"
        }
      },
      "title": "CashEstimate",
      "type": "object"
    },
    "CashEvidence": {
      "additionalProperties": false,
      "properties": {
        "charge_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Charge Id",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/CashClassification",
          "default": "unavailable"
        },
        "evidence": {
          "$ref": "#/$defs/MeasurementEvidence"
        },
        "rate_snapshot_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Snapshot Id"
        },
        "billing_record_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Billing Record Id"
        },
        "usage_fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Fingerprint"
        },
        "applied_rate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Applied Rate Ids",
          "type": "array"
        },
        "applied_meter_quantities": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Applied Meter Quantities",
          "type": "object"
        }
      },
      "required": [
        "charge_id"
      ],
      "title": "CashEvidence",
      "type": "object"
    },
    "CounterfactualCashCost": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "basis": {
          "const": "api_equivalent",
          "default": "api_equivalent",
          "title": "Basis",
          "type": "string"
        },
        "rate_snapshot_id": {
          "title": "Rate Snapshot Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "usage_fingerprint": {
          "title": "Usage Fingerprint",
          "type": "string"
        },
        "applied_rate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Applied Rate Ids",
          "type": "array"
        },
        "applied_meter_quantities": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Applied Meter Quantities",
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unavailable"
        }
      },
      "required": [
        "rate_snapshot_id",
        "provider",
        "model",
        "usage_fingerprint"
      ],
      "title": "CounterfactualCashCost",
      "type": "object"
    },
    "EstimateSource": {
      "enum": [
        "static",
        "historical",
        "blended",
        "quote",
        "observed"
      ],
      "title": "EstimateSource",
      "type": "string"
    },
    "EstimateUncertainty": {
      "additionalProperties": false,
      "description": "Empirical bounds from one exact evidence cohort; never authorization.",
      "properties": {
        "profile": {
          "const": "aeep-estimate-uncertainty-v1",
          "default": "aeep-estimate-uncertainty-v1",
          "title": "Profile",
          "type": "string"
        },
        "method": {
          "const": "empirical-nearest-rank-wilson-v1",
          "default": "empirical-nearest-rank-wilson-v1",
          "title": "Method",
          "type": "string"
        },
        "sample_size": {
          "minimum": 5,
          "title": "Sample Size",
          "type": "integer"
        },
        "cohort_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Cohort Digest",
          "type": "string"
        },
        "resources_p50": {
          "$ref": "#/$defs/ResourceVector"
        },
        "resources_p95": {
          "$ref": "#/$defs/ResourceVector"
        },
        "cash_p95_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Observed p95 only; never a payment authorization maximum.",
          "title": "Cash P95 Usd"
        },
        "success_lower_bound": {
          "maximum": 1,
          "minimum": 0,
          "title": "Success Lower Bound",
          "type": "number"
        },
        "quality_sample_size": {
          "default": 0,
          "minimum": 0,
          "title": "Quality Sample Size",
          "type": "integer"
        },
        "quality_lower_bound": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Lower Bound"
        }
      },
      "required": [
        "sample_size",
        "cohort_digest",
        "resources_p50",
        "resources_p95",
        "success_lower_bound"
      ],
      "title": "EstimateUncertainty",
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "billing_record",
        "local_meter",
        "priced_measured_billable_usage",
        "confirmed_no_incremental_charge",
        "provider_report",
        "pinned_rate_table",
        "operator_report",
        "static_estimate",
        "legacy_unspecified",
        "unavailable"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "complete",
        "partial",
        "conflict",
        "unavailable"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "ExecutionStatus": {
      "enum": [
        "success",
        "failed",
        "timeout",
        "rejected",
        "host_selected",
        "delegated",
        "unknown"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "ExecutorKind": {
      "enum": [
        "command",
        "python",
        "http",
        "mcp",
        "host",
        "host_managed",
        "delegate"
      ],
      "title": "ExecutorKind",
      "type": "string"
    },
    "MeasurementEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unavailable"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource",
          "default": "unavailable"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "untrusted"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "source_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[A-Fa-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        }
      },
      "title": "MeasurementEvidence",
      "type": "object"
    },
    "ModelAccessChannel": {
      "enum": [
        "api",
        "subscription",
        "purchased_credit",
        "mixed",
        "unknown"
      ],
      "title": "ModelAccessChannel",
      "type": "string"
    },
    "ModelTokenUsage": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "access_channel": {
          "$ref": "#/$defs/ModelAccessChannel",
          "default": "unknown"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "cache_write_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Write Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Output Tokens",
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/$defs/MeasurementEvidence"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "ModelTokenUsage",
      "type": "object"
    },
    "PolicyValuation": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "resource_pool": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Pool"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "explanation": {
          "default": "",
          "maxLength": 1000,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "policy_id"
      ],
      "title": "PolicyValuation",
      "type": "object"
    },
    "ResourceAccounting": {
      "additionalProperties": false,
      "properties": {
        "cash": {
          "$ref": "#/$defs/CashAccounting"
        },
        "subscription_usage": {
          "items": {
            "$ref": "#/$defs/SubscriptionUsage"
          },
          "title": "Subscription Usage",
          "type": "array"
        },
        "model_usage": {
          "items": {
            "$ref": "#/$defs/ModelTokenUsage"
          },
          "title": "Model Usage",
          "type": "array"
        },
        "tool_footprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolFootprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ResourceAccounting",
      "type": "object"
    },
    "ResourceVector": {
      "additionalProperties": false,
      "description": "Raw resource dimensions for one attempt.\n\n`memory_mb_seconds` is the integral of route-attributable resident memory\nover time. `peak_memory_mb` is retained separately because it is useful as a\nhard capacity constraint rather than only a consumable-resource signal.",
      "properties": {
        "monetary_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Monetary Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cpu Ms",
          "type": "number"
        },
        "memory_mb_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Memory Mb Seconds",
          "type": "number"
        },
        "peak_memory_mb": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Peak Memory Mb",
          "type": "number"
        },
        "gpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Gpu Ms",
          "type": "number"
        },
        "network_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Network Bytes",
          "type": "integer"
        },
        "context_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "cache_write_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Write Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Output Tokens",
          "type": "integer"
        },
        "subscription_units": {
          "default": 0.0,
          "description": "Provider-local capacity units; not cash and not transferable.",
          "minimum": 0.0,
          "title": "Subscription Units",
          "type": "number"
        }
      },
      "title": "ResourceVector",
      "type": "object"
    },
    "RouteEstimate": {
      "additionalProperties": false,
      "properties": {
        "resources": {
          "$ref": "#/$defs/ResourceVector"
        },
        "cash": {
          "$ref": "#/$defs/CashEstimate"
        },
        "subscription_usage": {
          "items": {
            "$ref": "#/$defs/SubscriptionUsage"
          },
          "title": "Subscription Usage",
          "type": "array"
        },
        "success_probability": {
          "default": 0.95,
          "maximum": 1.0,
          "minimum": 0.001,
          "title": "Success Probability",
          "type": "number"
        },
        "quality_score": {
          "default": 0.95,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality Score",
          "type": "number"
        },
        "risk_score": {
          "default": 0.05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/EstimateSource",
          "default": "static"
        },
        "sample_size": {
          "default": 0,
          "minimum": 0,
          "title": "Sample Size",
          "type": "integer"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/EstimateUncertainty"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "RouteEstimate",
      "type": "object"
    },
    "ScoreBreakdown": {
      "additionalProperties": false,
      "properties": {
        "monetary": {
          "default": 0.0,
          "title": "Monetary",
          "type": "number"
        },
        "cash": {
          "default": 0.0,
          "title": "Cash",
          "type": "number"
        },
        "policy_valuation": {
          "default": 0.0,
          "title": "Policy Valuation",
          "type": "number"
        },
        "latency": {
          "default": 0.0,
          "title": "Latency",
          "type": "number"
        },
        "compute": {
          "default": 0.0,
          "title": "Compute",
          "type": "number"
        },
        "subscription": {
          "default": 0.0,
          "title": "Subscription",
          "type": "number"
        },
        "reliability": {
          "default": 0.0,
          "title": "Reliability",
          "type": "number"
        },
        "quality": {
          "default": 0.0,
          "title": "Quality",
          "type": "number"
