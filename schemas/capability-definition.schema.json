{
  "$defs": {
    "SideEffect": {
      "enum": [
        "none",
        "read",
        "write",
        "destructive",
        "financial"
      ],
      "title": "SideEffect",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "namespace": {
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Namespace",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "default": "1",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$",
      "title": "Version",
      "type": "string"
    },
    "authority": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Domain, URI, or organization responsible for the canonical contract.",
      "title": "Authority"
    },
    "owner": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "deprecated"
      ],
      "title": "Status",
      "type": "string"
    },
    "replaced_by": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replaced By"
    },
    "compatible_versions": {
      "items": {
        "type": "string"
      },
      "title": "Compatible Versions",
      "type": "array"
    },
    "description": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "input_schema": {
      "additionalProperties": true,
      "title": "Input Schema",
      "type": "object"
    },
    "output_schema": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Schema"
    },
    "side_effect": {
      "$ref": "#/$defs/SideEffect",
      "default": "read"
    }
  },
  "required": [
    "namespace",
    "name",
    "description"
  ],
  "title": "CapabilityDefinition",
  "type": "object"
}
