{
  "$defs": {
    "ExtensionDependency": {
      "additionalProperties": false,
      "properties": {
        "extension_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
          "title": "Extension Id",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "extension_id",
        "manifest_sha256"
      ],
      "title": "ExtensionDependency",
      "type": "object"
    },
    "ExtensionManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "aeep.toolkit.extension.v1",
          "default": "aeep.toolkit.extension.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "extension_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
          "title": "Extension Id",
          "type": "string"
        },
        "purpose": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "role": {
          "enum": [
            "evaluator",
            "benchmark",
            "scanner",
            "catalog",
            "observability",
            "isolation",
            "router",
            "orchestrator",
            "support"
          ],
          "title": "Role",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourcePin"
        },
        "hosts": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Hosts",
          "type": "array"
        },
        "platforms": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Platforms",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ExtensionDependency"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "permissions": {
          "$ref": "#/$defs/ExtensionPermissions"
        },
        "disk_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disk Bytes"
        },
        "memory_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Bytes"
        },
        "install_effects": {
          "items": {
            "type": "string"
          },
          "title": "Install Effects",
          "type": "array"
        },
        "rollback": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rollback",
          "type": "string"
        },
        "status": {
          "enum": [
            "not_installed",
            "blocked",
            "experimental",
            "qualified"
          ],
          "title": "Status",
          "type": "string"
        },
        "qualification_ref": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualification Ref"
        },
        "blockers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        }
      },
      "required": [
        "extension_id",
        "purpose",
        "role",
        "source",
        "hosts",
        "platforms",
        "dependencies",
        "permissions",
        "disk_bytes",
        "memory_bytes",
        "install_effects",
        "rollback",
        "status"
      ],
      "title": "ExtensionManifest",
      "type": "object"
    },
    "ExtensionPermissions": {
      "additionalProperties": false,
      "properties": {
        "network_destinations": {
          "items": {
            "type": "string"
          },
          "title": "Network Destinations",
          "type": "array"
        },
        "filesystem_scope": {
          "enum": [
            "none",
            "workspace",
            "user",
            "system",
            "unknown"
          ],
          "title": "Filesystem Scope",
          "type": "string"
        },
        "authentication": {
          "enum": [
            "none",
            "host_owned",
            "operator_setup",
            "unknown"
          ],
          "title": "Authentication",
          "type": "string"
        },
        "financial_exposure": {
          "enum": [
            "none",
            "subscription_unpriced",
            "metered",
            "unknown"
          ],
          "title": "Financial Exposure",
          "type": "string"
        }
      },
      "required": [
        "network_destinations",
        "filesystem_scope",
        "authentication",
        "financial_exposure"
      ],
      "title": "ExtensionPermissions",
      "type": "object"
    },
    "InstallationPreview": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "aeep.toolkit.installation-preview.v1",
          "enum": [
            "aeep.toolkit.installation-preview.v1",
            "aeep.toolkit.installation-preview.v2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "storage_exception_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Exception Sha256"
        },
        "profile": {
          "enum": [
            "essentials",
            "evaluation",
            "full"
          ],
          "title": "Profile",
          "type": "string"
        },
        "selected": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
            "type": "string"
          },
          "title": "Selected",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/PreviewItem"
          },
          "title": "Items",
          "type": "array"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "known_disk_bytes": {
          "minimum": 0,
          "title": "Known Disk Bytes",
          "type": "integer"
        },
        "disk_complete": {
          "title": "Disk Complete",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "blocked",
            "ready_for_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "execution_authorized": {
          "const": false,
          "default": false,
          "title": "Execution Authorized",
          "type": "boolean"
        },
        "limitations": {
          "default": [
            "Metadata and supplied observations are declarations, not authenticated installation or conformance evidence.",
            "Memory figures are per component; simultaneous runtime consumption is unmeasured.",
            "This preview performs no installation and cannot authorize execution or spending."
          ],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "profile",
        "selected",
        "items",
        "blockers",
        "known_disk_bytes",
        "disk_complete",
        "status"
      ],
      "title": "InstallationPreview",
      "type": "object"
    },
    "InstalledObservation": {
      "additionalProperties": false,
      "properties": {
        "extension_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
          "title": "Extension Id",
          "type": "string"
        },
        "installed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installed"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Sha256"
        },
        "source_ref": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        }
      },
      "required": [
        "extension_id"
      ],
      "title": "InstalledObservation",
      "type": "object"
    },
    "PreviewItem": {
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "$ref": "#/$defs/ExtensionManifest"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "selection": {
          "enum": [
            "direct",
            "dependency"
          ],
          "title": "Selection",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/InstalledObservation"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        }
      },
      "required": [
        "manifest",
        "manifest_sha256",
        "selection",
        "observation",
        "blockers"
      ],
      "title": "PreviewItem",
      "type": "object"
    },
    "PreviewPolicy": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
          "title": "Host",
          "type": "string"
        },
        "platform": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
          "title": "Platform",
          "type": "string"
        },
        "allowed_licenses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Licenses",
          "type": "array"
        },
        "allowed_data_rights": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Data Rights",
          "type": "array"
        },
        "allowed_network_destinations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Network Destinations",
          "type": "array"
        },
        "allowed_filesystem_scopes": {
          "default": [
            "none"
          ],
          "items": {
            "enum": [
              "none",
              "workspace",
              "user",
              "system"
            ],
            "type": "string"
          },
          "title": "Allowed Filesystem Scopes",
          "type": "array"
        },
        "allowed_authentication": {
          "default": [
            "none"
          ],
          "items": {
            "enum": [
              "none",
              "host_owned",
              "operator_setup"
            ],
            "type": "string"
          },
          "title": "Allowed Authentication",
          "type": "array"
        },
        "allowed_financial_exposure": {
          "default": [
            "none"
          ],
          "items": {
            "enum": [
              "none",
              "subscription_unpriced",
              "metered"
            ],
            "type": "string"
          },
          "title": "Allowed Financial Exposure",
          "type": "array"
        },
        "free_disk_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Disk Bytes"
        },
        "allow_unknown_memory": {
          "default": false,
          "title": "Allow Unknown Memory",
          "type": "boolean"
        },
        "reviewed_dependency_manifests": {
          "default": [],
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Reviewed Dependency Manifests",
          "type": "array"
        }
      },
      "required": [
        "host",
        "platform"
      ],
      "title": "PreviewPolicy",
      "type": "object"
    },
    "SourcePin": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Revision",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "license_expression": {
          "maxLength": 200,
          "minLength": 1,
          "title": "License Expression",
          "type": "string"
        },
        "data_rights": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Data Rights",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "artifact_sha256",
        "license_expression",
        "data_rights"
      ],
      "title": "SourcePin",
      "type": "object"
    },
    "StorageReserveException": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "aeep.toolkit.storage-exception.v1",
          "default": "aeep.toolkit.storage-exception.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "exception_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
          "title": "Exception Id",
          "type": "string"
        },
        "purpose": {
          "const": "toolkit-engineering",
          "default": "toolkit-engineering",
          "title": "Purpose",
          "type": "string"
        },
        "destination": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        },
        "filesystem_device": {
          "minimum": 0,
          "title": "Filesystem Device",
          "type": "integer"
        },
        "wheel_set_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Wheel Set Sha256",
          "type": "string"
        },
        "minimum_free_bytes": {
          "exclusiveMaximum": 53687091200,
          "exclusiveMinimum": 0,
          "title": "Minimum Free Bytes",
          "type": "integer"
        },
        "maximum_additional_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 2147483648,
          "title": "Maximum Additional Bytes",
          "type": "integer"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "exception_id",
        "destination",
        "filesystem_device",
        "wheel_set_sha256",
        "minimum_free_bytes",
        "maximum_additional_bytes",
        "issued_at",
        "expires_at"
      ],
      "title": "StorageReserveException",
      "type": "object"
    },
    "Wheel": {
      "additionalProperties": false,
      "properties": {
        "extension_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
          "title": "Extension Id",
          "type": "string"
        },
        "filename": {
          "pattern": "^[A-Za-z0-9_.+!-]+\\.whl$",
          "title": "Filename",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9][A-Za-z0-9.+!_-]*$",
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "extension_id",
        "filename",
        "name",
        "version",
        "sha256"
      ],
      "title": "Wheel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "aeep.toolkit.runtime-installation.v1",
      "enum": [
        "aeep.toolkit.runtime-installation.v1",
        "aeep.toolkit.runtime-installation.v2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "storage_exception": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageReserveException"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preview": {
      "$ref": "#/$defs/InstallationPreview"
    },
    "policy": {
      "$ref": "#/$defs/PreviewPolicy"
    },
    "destination": {
      "title": "Destination",
      "type": "string"
    },
    "wheelhouse": {
      "title": "Wheelhouse",
      "type": "string"
    },
    "interpreter": {
      "title": "Interpreter",
      "type": "string"
    },
    "interpreter_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Interpreter Sha256",
      "type": "string"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "system": {
      "title": "System",
      "type": "string"
    },
    "machine": {
      "title": "Machine",
      "type": "string"
    },
    "wheels": {
      "items": {
        "$ref": "#/$defs/Wheel"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Wheels",
      "type": "array"
    },
    "effects": {
      "default": [
        "Create a new private Python environment and sibling installation journal/lock.",
        "Install only reviewed local wheels; no index, source builds, host activation or sign-in.",
        "Reserve staged/expanded wheel bytes and 500 MiB bootstrap headroom above the 50 GiB host reserve.",
        "Keep failed/interrupted state; no automatic retry. Preserve the journal on removal.",
        "Remove only a completely unchanged owned runtime; preserve conflicts for inspection."
      ],
      "items": {
        "type": "string"
      },
      "title": "Effects",
      "type": "array"
    }
  },
  "required": [
    "preview",
    "policy",
    "destination",
    "wheelhouse",
    "interpreter",
    "interpreter_sha256",
    "python_version",
    "system",
    "machine",
    "wheels"
  ],
  "title": "RuntimeInstallation",
  "type": "object"
}
