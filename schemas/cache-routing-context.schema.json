      "type": "string"
    },
    "provider": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "integration_adapter": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Integration Adapter",
      "type": "string"
    },
    "route_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Route Id",
      "type": "string"
    },
    "stable_prefix_digest_hmac": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Stable Prefix Digest Hmac",
      "type": "string"
    },
    "previous_state_digest_hmac": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
