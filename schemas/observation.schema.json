{
  "$defs": {
    "ResourceVector": {
      "additionalProperties": false,
      "description": "Raw resource dimensions for one attempt.\n\n`memory_mb_seconds` is the integral of route-attributable resident memory\nover time. `peak_memory_mb` is retained separately because it is useful as a\nhard capacity constraint rather than only a consumable-resource signal.",
      "properties": {
        "monetary_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Monetary Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cpu Ms",
          "type": "number"
        },
        "memory_mb_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Memory Mb Seconds",
          "type": "number"
        },
        "peak_memory_mb": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Peak Memory Mb",
          "type": "number"
        },
        "gpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Gpu Ms",
          "type": "number"
        },
        "network_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Network Bytes",
          "type": "integer"
        },
        "context_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "subscription_units": {
          "default": 0.0,
          "description": "Provider-local capacity units; not cash and not transferable.",
          "minimum": 0.0,
          "title": "Subscription Units",
          "type": "number"
        }
      },
      "title": "ResourceVector",
      "type": "object"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "hmac-sha256",
          "default": "hmac-sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "value": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "value"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    },
    "TrustLevel": {
      "enum": [
        "untrusted",
        "self_asserted",
        "observed",
        "verified",
        "attested"
      ],
      "title": "TrustLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "provider_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Id"
    },
    "executor_id": {
      "title": "Executor Id",
      "type": "string"
    },
    "capability": {
      "title": "Capability",
      "type": "string"
    },
    "receipt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt Id"
    },
    "resources": {
      "$ref": "#/$defs/ResourceVector"
    },
    "transport_success": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transport Success"
    },
    "execution_success": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Success"
    },
    "schema_valid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Valid"
    },
    "task_valid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Valid"
    },
    "quality_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality Score"
    },
    "trust": {
      "$ref": "#/$defs/TrustLevel",
      "default": "untrusted"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "attestation": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignatureEnvelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "executor_id",
    "capability"
  ],
  "title": "Observation",
  "type": "object"
}
