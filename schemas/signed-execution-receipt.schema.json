{
  "$defs": {
    "EstimateSource": {
      "enum": [
        "static",
        "historical",
        "blended",
        "quote",
        "observed"
      ],
      "title": "EstimateSource",
      "type": "string"
    },
    "ExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "title": "Receipt Id",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "executor_id": {
          "title": "Executor Id",
          "type": "string"
        },
        "executor_kind": {
          "$ref": "#/$defs/ExecutorKind"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "estimated": {
          "$ref": "#/$defs/RouteEstimate"
        },
        "actual_resources": {
          "$ref": "#/$defs/ResourceVector"
        },
        "transport_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Success"
        },
        "execution_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Success"
        },
        "schema_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Valid"
        },
        "task_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Valid"
        },
        "quality_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Score"
        },
        "validation_results": {
          "items": {
            "$ref": "#/$defs/ValidationResult"
          },
          "title": "Validation Results",
          "type": "array"
        },
        "output_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Valid"
        },
        "error_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "decision_id",
        "action_id",
        "capability",
        "executor_id",
        "executor_kind",
        "status",
        "estimated"
      ],
      "title": "ExecutionReceipt",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "success",
        "failed",
        "timeout",
        "rejected",
        "host_selected",
        "delegated",
        "unknown"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "ExecutorKind": {
      "enum": [
        "command",
        "python",
        "http",
        "mcp",
        "host",
        "delegate"
      ],
      "title": "ExecutorKind",
      "type": "string"
    },
    "ResourceVector": {
      "additionalProperties": false,
      "description": "Raw resource dimensions for one attempt.\n\n`memory_mb_seconds` is the integral of route-attributable resident memory\nover time. `peak_memory_mb` is retained separately because it is useful as a\nhard capacity constraint rather than only a consumable-resource signal.",
      "properties": {
        "monetary_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Monetary Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cpu Ms",
          "type": "number"
        },
        "memory_mb_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Memory Mb Seconds",
          "type": "number"
        },
        "peak_memory_mb": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Peak Memory Mb",
          "type": "number"
        },
        "gpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Gpu Ms",
          "type": "number"
        },
        "network_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Network Bytes",
          "type": "integer"
        },
        "context_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "subscription_units": {
          "default": 0.0,
          "description": "Provider-local capacity units; not cash and not transferable.",
          "minimum": 0.0,
          "title": "Subscription Units",
          "type": "number"
        }
      },
      "title": "ResourceVector",
      "type": "object"
    },
    "RouteEstimate": {
      "additionalProperties": false,
      "properties": {
        "resources": {
          "$ref": "#/$defs/ResourceVector"
        },
        "success_probability": {
          "default": 0.95,
          "maximum": 1.0,
          "minimum": 0.001,
          "title": "Success Probability",
          "type": "number"
        },
        "quality_score": {
          "default": 0.95,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality Score",
          "type": "number"
        },
        "risk_score": {
          "default": 0.05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/EstimateSource",
          "default": "static"
        },
        "sample_size": {
          "default": 0,
          "minimum": 0,
          "title": "Sample Size",
          "type": "integer"
        }
      },
      "title": "RouteEstimate",
      "type": "object"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "hmac-sha256",
          "default": "hmac-sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "value": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "value"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    },
    "TrustLevel": {
      "enum": [
        "untrusted",
        "self_asserted",
        "observed",
        "verified",
        "attested"
      ],
      "title": "TrustLevel",
      "type": "string"
    },
    "ValidationKind": {
      "enum": [
        "schema",
        "exact_match",
        "range",
        "state_transition",
        "callback",
        "downstream",
        "llm",
        "human"
      ],
      "title": "ValidationKind",
      "type": "string"
    },
    "ValidationResult": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ValidationKind"
        },
        "valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid"
        },
        "quality_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Score"
        },
        "detail": {
          "default": "",
          "maxLength": 4096,
          "title": "Detail",
          "type": "string"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "observed"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ValidationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "receipt": {
      "$ref": "#/$defs/ExecutionReceipt"
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelope"
    }
  },
  "required": [
    "receipt",
    "signature"
  ],
  "title": "SignedExecutionReceipt",
  "type": "object"
}
