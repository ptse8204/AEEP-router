{
  "$defs": {
    "AuthorizationKind": {
      "description": "Immutable economic basis for a maximum cash authorization.",
      "enum": [
        "SIGNED_QUOTE",
        "PUBLISHED_OFFER",
        "PINNED_RATE_CARD"
      ],
      "title": "AuthorizationKind",
      "type": "string"
    },
    "AuthorizationMeterQuantity": {
      "additionalProperties": false,
      "description": "One pinned rate-card rate and the bounded native quantity it prices.",
      "properties": {
        "meter": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Meter",
          "type": "string"
        },
        "unit": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Unit",
          "type": "string"
        },
        "quantity": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "rate_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Rate Id",
          "type": "string"
        }
      },
      "required": [
        "meter",
        "unit",
        "quantity",
        "rate_id"
      ],
      "title": "AuthorizationMeterQuantity",
      "type": "object"
    },
    "CandidateRanking": {
      "additionalProperties": false,
      "properties": {
        "executor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Executor Id",
          "type": "string"
        },
        "executor_fingerprint": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Executor Fingerprint",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "quote_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Id"
        },
        "expected_amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurrencyAmount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "maximum_amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurrencyAmount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_level": {
          "$ref": "#/$defs/EconomicEvidenceLevel",
          "default": "UNKNOWN"
        },
        "explanation": {
          "default": "",
          "maxLength": 2000,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "executor_id",
        "executor_fingerprint",
        "rank"
      ],
      "title": "CandidateRanking",
      "type": "object"
    },
    "CashAccounting": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unavailable"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/CashEvidence"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "title": "CashAccounting",
      "type": "object"
    },
    "CashClassification": {
      "enum": [
        "verified",
        "billing_reconciled",
        "pinned_rate_billable_usage",
        "estimated",
        "unavailable"
      ],
      "title": "CashClassification",
      "type": "string"
    },
    "CashEvidence": {
      "additionalProperties": false,
      "properties": {
        "charge_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Charge Id",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/CashClassification",
          "default": "unavailable"
        },
        "evidence": {
          "$ref": "#/$defs/MeasurementEvidence"
        },
        "rate_snapshot_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Snapshot Id"
        },
        "billing_record_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Billing Record Id"
        },
        "usage_fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Fingerprint"
        },
        "applied_rate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Applied Rate Ids",
          "type": "array"
        },
        "applied_meter_quantities": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Applied Meter Quantities",
          "type": "object"
        }
      },
      "required": [
        "charge_id"
      ],
      "title": "CashEvidence",
      "type": "object"
    },
    "CurrencyAmount": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "CurrencyAmount",
      "type": "object"
    },
    "EconomicEvidenceLevel": {
      "enum": [
        "UNKNOWN",
        "STATIC_PRIOR",
        "PUBLISHED_OFFER",
        "SIGNED_QUOTE",
        "SIGNED_USAGE_STATEMENT",
        "PAYMENT_SETTLEMENT",
        "BILLING_RECONCILED",
        "OPERATOR_ATTESTED"
      ],
      "title": "EconomicEvidenceLevel",
      "type": "string"
    },
    "EvidenceSource": {
      "enum": [
        "billing_record",
        "local_meter",
        "priced_measured_billable_usage",
        "confirmed_no_incremental_charge",
        "provider_report",
        "pinned_rate_table",
        "operator_report",
        "static_estimate",
        "legacy_unspecified",
        "unavailable"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "complete",
        "partial",
        "conflict",
        "unavailable"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "MeasurementEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unavailable"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource",
          "default": "unavailable"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "untrusted"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "source_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[A-Fa-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        }
      },
      "title": "MeasurementEvidence",
      "type": "object"
    },
    "ModelAccessChannel": {
      "enum": [
        "api",
        "subscription",
        "purchased_credit",
        "mixed",
        "unknown"
      ],
      "title": "ModelAccessChannel",
      "type": "string"
    },
    "ModelTokenUsage": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "access_channel": {
          "$ref": "#/$defs/ModelAccessChannel",
          "default": "unknown"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "cache_write_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Write Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Output Tokens",
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/$defs/MeasurementEvidence"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "ModelTokenUsage",
      "type": "object"
    },
    "PreparedDecisionState": {
      "enum": [
        "PREPARED",
        "RESERVED",
        "INVOKING",
        "AWAITING_USAGE",
        "SETTLING",
        "SETTLED",
        "RELEASED",
        "INDETERMINATE",
        "DISPUTED",
        "EXPIRED",
        "CANCELLED"
      ],
      "title": "PreparedDecisionState",
      "type": "string"
    },
    "QuoteFailure": {
      "additionalProperties": false,
      "properties": {
        "executor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Executor Id",
          "type": "string"
        },
        "provider_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "executor_id",
        "code",
        "reason"
      ],
      "title": "QuoteFailure",
      "type": "object"
    },
    "QuoteFailurePolicy": {
      "enum": [
        "REQUIRE_BINDING_QUOTE",
        "ALLOW_VERIFIED_OFFER",
        "ALLOW_STATIC_PRIOR",
        "TREAT_AS_UNAVAILABLE"
      ],
      "title": "QuoteFailurePolicy",
      "type": "string"
    },
    "RejectedCandidate": {
      "additionalProperties": false,
      "properties": {
        "executor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Executor Id",
          "type": "string"
        },
        "executor_fingerprint": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executor Fingerprint"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "quote_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Id"
        }
      },
      "required": [
        "executor_id",
        "reasons"
      ],
      "title": "RejectedCandidate",
      "type": "object"
    },
    "ResourceAccounting": {
      "additionalProperties": false,
      "properties": {
        "cash": {
          "$ref": "#/$defs/CashAccounting"
        },
        "subscription_usage": {
          "items": {
            "$ref": "#/$defs/SubscriptionUsage"
          },
          "title": "Subscription Usage",
          "type": "array"
        },
        "model_usage": {
          "items": {
            "$ref": "#/$defs/ModelTokenUsage"
          },
          "title": "Model Usage",
          "type": "array"
        },
        "tool_footprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolFootprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ResourceAccounting",
      "type": "object"
    },
    "SubscriptionCharge": {
      "enum": [
        "included",
        "paid",
        "mixed",
        "unknown"
      ],
      "title": "SubscriptionCharge",
      "type": "string"
    },
    "SubscriptionUsage": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "resource_pool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Resource Pool",
          "type": "string"
        },
        "unit": {
          "default": "provider_unit",
          "maxLength": 100,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "consumed": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumed"
        },
        "source": {
          "$ref": "#/$defs/MeasurementEvidence"
        },
        "included_or_paid": {
          "$ref": "#/$defs/SubscriptionCharge",
          "default": "unknown"
        },
        "rate_snapshot_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Snapshot Id"
        },
        "usage_fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Fingerprint"
        }
      },
      "required": [
        "provider",
        "resource_pool"
      ],
      "title": "SubscriptionUsage",
      "type": "object"
    },
    "ToolFootprint": {
      "additionalProperties": false,
      "properties": {
        "schema_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Schema Bytes",
          "type": "integer"
        },
        "schema_approx_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Schema Approx Tokens",
          "type": "integer"
        },
        "raw_result_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Raw Result Bytes",
          "type": "integer"
        },
        "raw_result_approx_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Raw Result Approx Tokens",
          "type": "integer"
        },
        "filtered_result_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Filtered Result Bytes",
          "type": "integer"
        },
        "filtered_result_approx_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Filtered Result Approx Tokens",
          "type": "integer"
        },
        "exposed_to_model": {
          "default": false,
          "title": "Exposed To Model",
          "type": "boolean"
        }
      },
      "title": "ToolFootprint",
      "type": "object"
    },
    "TrustLevel": {
      "enum": [
        "untrusted",
        "self_asserted",
        "observed",
        "verified",
        "attested"
      ],
      "title": "TrustLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.4",
      "default": "0.4",
      "title": "Schema Version",
      "type": "string"
    },
    "prepared_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Prepared Id",
      "type": "string"
    },
    "action_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Action Id",
      "type": "string"
    },
    "action_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Action Digest",
      "type": "string"
    },
    "effective_policy_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Effective Policy Digest",
      "type": "string"
    },
    "selected_executor_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Executor Id"
    },
    "selected_executor_fingerprint": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Executor Fingerprint"
    },
    "selected_quote_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Quote Id"
    },
    "selected_offer_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Offer Id"
    },
    "selected_rate_card_id": {
      "anyOf": [
        {
          "pattern": "^rate_[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Rate Card Id"
    },
    "authorization_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authorization_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization Id"
    },
    "authorization_rate_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Authorization Rate Ids",
      "type": "array"
    },
    "authorization_meter_quantities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AuthorizationMeterQuantity"
      },
      "title": "Authorization Meter Quantities",
      "type": "array"
    },
    "quote_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Quote Ids",
      "type": "array"
    },
    "candidate_rankings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateRanking"
      },
      "title": "Candidate Rankings",
      "type": "array"
    },
    "rejected_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RejectedCandidate"
      },
      "title": "Rejected Candidates",
      "type": "array"
    },
    "quote_failures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/QuoteFailure"
      },
      "title": "Quote Failures",
      "type": "array"
    },
    "disclosed_quote_features": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Disclosed Quote Features",
      "type": "object"
    },
    "expected_accounting": {
      "$ref": "#/$defs/ResourceAccounting"
    },
    "maximum_cash_authorization": {
      "anyOf": [
        {
          "$ref": "#/$defs/CurrencyAmount"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quote_failure_policy": {
      "$ref": "#/$defs/QuoteFailurePolicy",
