    },
    "preparation_latency_ms": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preparation Latency Ms"
    },
    "quote_latency_ms": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Latency Ms"
    },
    "quote_request_count": {
      "default": 0,
      "minimum": 0,
      "title": "Quote Request Count",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/PreparedDecisionState",
      "default": "PREPARED"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    }
  },
  "required": [
    "action_id",
    "action_digest",
    "effective_policy_digest",
    "expires_at"
  ],
  "title": "PreparedRouteDecision",
  "type": "object"
}
