{
  "$defs": {
    "ArtifactCompression": {
      "enum": [
        "none",
        "gzip"
      ],
      "title": "ArtifactCompression",
      "type": "string"
    },
    "ArtifactLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "uri": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "oci": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oci"
        }
      },
      "title": "ArtifactLocation",
      "type": "object"
    },
    "ArtifactPurpose": {
      "enum": [
        "executable",
        "schema",
        "qualification",
        "benchmark",
        "comparison",
        "rate_card",
        "compatibility",
        "smoke_fixture",
        "other"
      ],
      "title": "ArtifactPurpose",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 52428800,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "location": {
          "$ref": "#/$defs/ArtifactLocation"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "compression": {
          "$ref": "#/$defs/ArtifactCompression",
          "default": "none"
        },
        "purpose": {
          "$ref": "#/$defs/ArtifactPurpose",
          "default": "other"
        }
      },
      "required": [
        "artifact_id",
        "digest",
        "media_type",
        "size_bytes",
        "location"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "CapabilityDefinition": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Namespace",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "1",
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$",
          "title": "Version",
          "type": "string"
        },
        "authority": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Domain, URI, or organization responsible for the canonical contract.",
          "title": "Authority"
        },
        "owner": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "deprecated"
          ],
          "title": "Status",
          "type": "string"
        },
        "replaced_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaced By"
        },
        "compatible_versions": {
          "items": {
            "type": "string"
          },
          "title": "Compatible Versions",
          "type": "array"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect",
          "default": "read"
        }
      },
      "required": [
        "namespace",
        "name",
        "description"
      ],
      "title": "CapabilityDefinition",
      "type": "object"
    },
    "CashEstimate": {
      "additionalProperties": false,
      "properties": {
        "amount_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Usd"
        },
        "upper_bound_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound Usd"
        },
        "evidence": {
          "$ref": "#/$defs/MeasurementEvidence"
        }
      },
      "title": "CashEstimate",
      "type": "object"
    },
    "CurrencyAmount": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "CurrencyAmount",
      "type": "object"
    },
    "EstimateSource": {
      "enum": [
        "static",
        "historical",
        "blended",
        "quote",
        "observed"
      ],
      "title": "EstimateSource",
      "type": "string"
    },
    "EvidenceAttestation": {
      "additionalProperties": false,
      "properties": {
        "attestation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Attestation Id",
          "type": "string"
        },
        "algorithm": {
          "const": "ed25519",
          "default": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "evidence_producer",
            "independent_verifier"
          ],
          "title": "Role",
          "type": "string"
        },
        "payload_type": {
          "const": "application/vnd.aeep.evidence-attestation+json;version=1",
          "default": "application/vnd.aeep.evidence-attestation+json;version=1",
          "title": "Payload Type",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "signature": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Signature",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        }
      },
      "required": [
        "attestation_id",
        "key_id",
        "role",
        "digest",
        "signature",
        "issued_at"
      ],
      "title": "EvidenceAttestation",
      "type": "object"
    },
    "EvidenceProducer": {
      "additionalProperties": false,
      "properties": {
        "producer_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Producer Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/TrustedKeyRole"
        },
        "key_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Id"
        }
      },
      "required": [
        "producer_id",
        "role"
      ],
      "title": "EvidenceProducer",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/EvidenceSubject"
        },
        "producer": {
          "$ref": "#/$defs/EvidenceProducer"
        },
        "trust_claim": {
          "$ref": "#/$defs/TrustLevel",
          "default": "untrusted"
        },
        "validity": {
          "$ref": "#/$defs/EvidenceValidity"
        },
        "summary": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "summary_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Digest"
        },
        "attestations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceAttestation"
          },
          "title": "Attestations",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type",
        "artifact_id",
        "subject",
        "producer",
        "validity"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "billing_record",
        "local_meter",
        "priced_measured_billable_usage",
        "confirmed_no_incremental_charge",
        "provider_report",
        "pinned_rate_table",
        "operator_report",
        "static_estimate",
        "legacy_unspecified",
        "unavailable"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "complete",
        "partial",
        "conflict",
        "unavailable"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceSubject": {
      "additionalProperties": false,
      "properties": {
        "route_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Route Id",
          "type": "string"
        },
        "capability": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*@[0-9]+(?:\\.[0-9]+){0,2}$",
          "title": "Capability",
          "type": "string"
        },
        "route_fingerprint": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Route Fingerprint",
          "type": "string"
        },
        "workload_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Digest"
        },
        "executor_artifact_digests": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Executor Artifact Digests",
          "type": "array"
        },
        "model_identity": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Identity"
        },
        "protocol_identity": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Identity"
        },
        "environment_class": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Class"
        }
      },
      "required": [
        "route_id",
        "capability",
        "route_fingerprint"
      ],
      "title": "EvidenceSubject",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "qualification_report",
        "benchmark_campaign",
        "comparison_report",
        "rate_card_snapshot",
        "compatibility_report",
        "revocation_statement"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "EvidenceValidity": {
      "additionalProperties": false,
      "properties": {
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "not_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Before"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        }
      },
      "required": [
        "issued_at"
      ],
      "title": "EvidenceValidity",
      "type": "object"
    },
    "ExecutorKind": {
      "enum": [
        "command",
        "python",
        "http",
        "mcp",
        "host",
        "delegate"
      ],
      "title": "ExecutorKind",
      "type": "string"
    },
    "JsonValue": {},
    "Locality": {
      "enum": [
        "in_process",
        "local",
        "lan",
        "internet"
      ],
      "title": "Locality",
      "type": "string"
    },
    "MeasurementEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unavailable"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource",
          "default": "unavailable"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "untrusted"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "source_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[A-Fa-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        }
      },
      "title": "MeasurementEvidence",
      "type": "object"
    },
    "ProviderCompatibility": {
      "additionalProperties": false,
      "properties": {
        "aeep_min": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Aeep Min",
          "type": "string"
        },
        "aeep_max_exclusive": {
          "anyOf": [
            {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aeep Max Exclusive"
        },
        "python": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python"
        },
        "platforms": {
          "default": [
            "any"
          ],
          "items": {
            "enum": [
              "linux",
              "macos",
              "windows",
              "any"
            ],
            "type": "string"
          },
          "title": "Platforms",
          "type": "array"
        },
        "protocols": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Protocols",
          "type": "array"
        }
      },
      "required": [
        "aeep_min"
      ],
      "title": "ProviderCompatibility",
      "type": "object"
    },
    "ProviderIdentity": {
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Provider Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "publisher": {
          "$ref": "#/$defs/PublisherIdentity"
        },
        "homepage": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Homepage"
        },
        "source_repository": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Repository"
        },
        "keys": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProviderPublicKey"
          },
          "title": "Keys",
          "type": "array"
        }
      },
      "required": [
        "provider_id",
        "display_name",
        "publisher"
      ],
      "title": "ProviderIdentity",
      "type": "object"
    },
    "ProviderPackageIntegrity": {
      "additionalProperties": false,
      "properties": {
        "canonicalization": {
          "const": "RFC8785",
          "default": "RFC8785",
          "title": "Canonicalization",
          "type": "string"
        },
        "digest_algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Digest Algorithm",
          "type": "string"
        },
        "payload_scope": {
          "const": "apiVersion+kind+metadata+spec",
          "default": "apiVersion+kind+metadata+spec",
          "title": "Payload Scope",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "digest"
      ],
      "title": "ProviderPackageIntegrity",
      "type": "object"
    },
    "ProviderPackageMetadata": {
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Package Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "title": "Version",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Labels",
          "type": "object"
        }
      },
      "required": [
        "package_id",
        "version",
        "issued_at"
      ],
      "title": "ProviderPackageMetadata",
      "type": "object"
    },
    "ProviderPackageSignature": {
      "additionalProperties": false,
      "properties": {
        "signature_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Signature Id",
          "type": "string"
        },
        "algorithm": {
          "const": "ed25519",
          "default": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "role": {
          "const": "package_publisher",
          "default": "package_publisher",
          "title": "Role",
          "type": "string"
        },
        "payload_type": {
          "const": "application/vnd.aeep.provider-package-digest+json;version=1",
          "default": "application/vnd.aeep.provider-package-digest+json;version=1",
          "title": "Payload Type",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "signature": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Signature",
          "type": "string"
        },
