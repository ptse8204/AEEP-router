{
  "$defs": {
    "ResourceVector": {
      "additionalProperties": false,
      "description": "Raw resource dimensions for one attempt.\n\n`memory_mb_seconds` is the integral of route-attributable resident memory\nover time. `peak_memory_mb` is retained separately because it is useful as a\nhard capacity constraint rather than only a consumable-resource signal.",
      "properties": {
        "monetary_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Monetary Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cpu Ms",
          "type": "number"
        },
        "memory_mb_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Memory Mb Seconds",
          "type": "number"
        },
        "peak_memory_mb": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Peak Memory Mb",
          "type": "number"
        },
        "gpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Gpu Ms",
          "type": "number"
        },
        "network_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Network Bytes",
          "type": "integer"
        },
        "context_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "cache_write_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Write Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Output Tokens",
          "type": "integer"
        },
        "subscription_units": {
          "default": 0.0,
          "description": "Provider-local capacity units; not cash and not transferable.",
          "minimum": 0.0,
          "title": "Subscription Units",
          "type": "number"
        }
      },
      "title": "ResourceVector",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Empirical bounds from one exact evidence cohort; never authorization.",
  "properties": {
    "profile": {
      "const": "aeep-estimate-uncertainty-v1",
      "default": "aeep-estimate-uncertainty-v1",
      "title": "Profile",
      "type": "string"
    },
    "method": {
      "const": "empirical-nearest-rank-wilson-v1",
      "default": "empirical-nearest-rank-wilson-v1",
      "title": "Method",
      "type": "string"
    },
    "sample_size": {
      "minimum": 5,
      "title": "Sample Size",
      "type": "integer"
    },
    "cohort_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Cohort Digest",
      "type": "string"
    },
    "resources_p50": {
      "$ref": "#/$defs/ResourceVector"
    },
    "resources_p95": {
      "$ref": "#/$defs/ResourceVector"
    },
    "cash_p95_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Observed p95 only; never a payment authorization maximum.",
      "title": "Cash P95 Usd"
    },
    "success_lower_bound": {
      "maximum": 1,
      "minimum": 0,
      "title": "Success Lower Bound",
      "type": "number"
    },
    "quality_sample_size": {
      "default": 0,
      "minimum": 0,
      "title": "Quality Sample Size",
      "type": "integer"
    },
    "quality_lower_bound": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality Lower Bound"
    }
  },
  "required": [
    "sample_size",
    "cohort_digest",
    "resources_p50",
    "resources_p95",
    "success_lower_bound"
  ],
  "title": "EstimateUncertainty",
  "type": "object"
}
