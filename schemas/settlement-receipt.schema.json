{
  "$defs": {
    "AuthorizationKind": {
      "description": "Immutable economic basis for a maximum cash authorization.",
      "enum": [
        "SIGNED_QUOTE",
        "PUBLISHED_OFFER",
        "PINNED_RATE_CARD"
      ],
      "title": "AuthorizationKind",
      "type": "string"
    },
    "CurrencyAmount": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "CurrencyAmount",
      "type": "object"
    },
    "EconomicEvidenceLevel": {
      "enum": [
        "UNKNOWN",
        "STATIC_PRIOR",
        "PUBLISHED_OFFER",
        "SIGNED_QUOTE",
        "SIGNED_USAGE_STATEMENT",
        "PAYMENT_SETTLEMENT",
        "BILLING_RECONCILED",
        "OPERATOR_ATTESTED"
      ],
      "title": "EconomicEvidenceLevel",
      "type": "string"
    },
    "SettlementStatus": {
      "enum": [
        "PENDING",
        "COMPLETED",
        "SETTLED",
        "RELEASED",
        "INDETERMINATE",
        "DISPUTED",
        "REFUNDED",
        "FAILED"
      ],
      "title": "SettlementStatus",
      "type": "string"
    },
    "SignatureAlgorithm": {
      "enum": [
        "hmac-sha256",
        "ed25519"
      ],
      "title": "SignatureAlgorithm",
      "type": "string"
    },
    "SignatureEnvelopeV2": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/SignatureAlgorithm"
        },
        "key_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Key Id",
          "type": "string"
        },
        "value": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Value",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "aeep-canonical-json-v1",
          "default": "aeep-canonical-json-v1",
          "title": "Canonicalization Version",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "title": "SignatureEnvelopeV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.4",
      "default": "0.4",
      "title": "Schema Version",
      "type": "string"
    },
    "settlement_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Settlement Id",
      "type": "string"
    },
    "charge_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Charge Id",
      "type": "string"
    },
    "prepared_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Prepared Id",
      "type": "string"
    },
    "quote_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Id"
    },
    "authorization_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authorization_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization Id"
    },
    "reservation_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Reservation Id",
      "type": "string"
    },
    "attempt_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Attempt Id",
      "type": "string"
    },
    "reserved_amount": {
      "$ref": "#/$defs/CurrencyAmount"
    },
    "captured_amount": {
      "$ref": "#/$defs/CurrencyAmount"
    },
    "released_amount": {
      "$ref": "#/$defs/CurrencyAmount"
    },
    "payment_rail": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Payment Rail",
      "type": "string"
    },
    "external_reference": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Reference"
    },
    "status": {
      "$ref": "#/$defs/SettlementStatus"
    },
    "evidence_level": {
      "$ref": "#/$defs/EconomicEvidenceLevel"
    },
    "settled_at": {
      "format": "date-time",
      "title": "Settled At",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignatureEnvelopeV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "settlement_id",
    "charge_id",
    "prepared_id",
    "reservation_id",
    "attempt_id",
    "reserved_amount",
    "captured_amount",
    "released_amount",
    "payment_rail",
    "status",
    "evidence_level",
    "settled_at"
  ],
  "title": "SettlementReceipt",
  "type": "object"
}
