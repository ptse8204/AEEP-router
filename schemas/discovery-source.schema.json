{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "discovery.source.v1",
      "default": "discovery.source.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_record_id": {
      "title": "Source Record Id",
      "type": "string"
    },
    "discovery_id": {
      "title": "Discovery Id",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "adapter_id": {
      "title": "Adapter Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "query_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Query Digest",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "fallback",
        "failed",
        "timeout",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "candidate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Ids",
      "type": "array"
    },
    "candidate_digests": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Digests",
      "type": "array"
    },
    "elapsed_ms": {
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "number"
    },
    "cash_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cash Usd"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "source_record_id",
    "discovery_id",
    "source_id",
    "adapter_id",
    "created_at",
    "query_digest",
    "status",
    "elapsed_ms"
  ],
  "title": "DiscoverySourceRecord",
  "type": "object"
}
