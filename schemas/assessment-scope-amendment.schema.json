      "title": "Subject Digests",
      "type": "array"
    },
    "recipe_digests": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Recipe Digests",
      "type": "array"
    },
    "environment_digests": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Environment Digests",
      "type": "array"
    },
    "reviewed_digests": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Reviewed Digests",
      "type": "array"
    },
    "issued_at": {
