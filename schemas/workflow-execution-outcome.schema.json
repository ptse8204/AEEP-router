{
  "$defs": {
    "ActionFeatures": {
      "additionalProperties": false,
      "description": "Non-payload characteristics used to condition historical estimates.",
      "properties": {
        "input_bytes": {
          "minimum": 0,
          "title": "Input Bytes",
          "type": "integer"
        },
        "input_items": {
          "minimum": 0,
          "title": "Input Items",
          "type": "integer"
        },
        "text_characters": {
          "minimum": 0,
          "title": "Text Characters",
          "type": "integer"
        },
        "max_depth": {
          "minimum": 0,
          "title": "Max Depth",
          "type": "integer"
        },
        "size_bucket": {
          "pattern": "^(empty|2\\^[0-9]+)$",
          "title": "Size Bucket",
          "type": "string"
        }
      },
      "required": [
        "input_bytes",
        "input_items",
        "text_characters",
        "max_depth",
        "size_bucket"
      ],
      "title": "ActionFeatures",
      "type": "object"
    },
    "CacheAffinityReceipt": {
      "additionalProperties": false,
      "properties": {
        "predicted_warm_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Predicted Warm Probability",
          "type": "number"
        },
        "predicted_common_prefix_tokens": {
          "minimum": 0,
          "title": "Predicted Common Prefix Tokens",
          "type": "integer"
        },
        "predicted_eligible_cached_tokens": {
          "minimum": 0,
          "title": "Predicted Eligible Cached Tokens",
          "type": "integer"
        },
        "predicted_cache_read_tokens": {
          "minimum": 0,
          "title": "Predicted Cache Read Tokens",
          "type": "integer"
        },
        "predicted_cache_write_tokens": {
          "minimum": 0,
          "title": "Predicted Cache Write Tokens",
          "type": "integer"
        },
        "actual_input_tokens": {
          "minimum": 0,
          "title": "Actual Input Tokens",
          "type": "integer"
        },
        "actual_cached_input_tokens": {
          "minimum": 0,
          "title": "Actual Cached Input Tokens",
          "type": "integer"
        },
        "actual_cache_write_tokens": {
          "minimum": 0,
          "title": "Actual Cache Write Tokens",
          "type": "integer"
        },
        "actual_output_tokens": {
          "minimum": 0,
          "title": "Actual Output Tokens",
          "type": "integer"
        },
        "actual_reasoning_output_tokens": {
          "minimum": 0,
          "title": "Actual Reasoning Output Tokens",
          "type": "integer"
        },
        "cache_hit_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Hit Rate"
        },
        "cache_scope_key_hmac": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Cache Scope Key Hmac",
          "type": "string"
        },
        "stable_prefix_digest_hmac": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Stable Prefix Digest Hmac",
          "type": "string"
        },
        "context_compaction_events": {
          "default": 0,
          "minimum": 0,
          "title": "Context Compaction Events",
          "type": "integer"
        },
        "context_reset_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Reset Reason"
        },
        "warm_state_reused": {
          "title": "Warm State Reused",
          "type": "boolean"
        }
      },
      "required": [
        "predicted_warm_probability",
        "predicted_common_prefix_tokens",
        "predicted_eligible_cached_tokens",
        "predicted_cache_read_tokens",
        "predicted_cache_write_tokens",
        "actual_input_tokens",
        "actual_cached_input_tokens",
        "actual_cache_write_tokens",
        "actual_output_tokens",
        "actual_reasoning_output_tokens",
        "cache_scope_key_hmac",
        "stable_prefix_digest_hmac",
        "warm_state_reused"
      ],
      "title": "CacheAffinityReceipt",
      "type": "object"
    },
    "CashAccounting": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unavailable"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/CashEvidence"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "title": "CashAccounting",
      "type": "object"
    },
    "CashClassification": {
      "enum": [
        "verified",
        "billing_reconciled",
        "pinned_rate_billable_usage",
        "estimated",
        "unavailable"
      ],
      "title": "CashClassification",
      "type": "string"
    },
    "CashEstimate": {
      "additionalProperties": false,
      "properties": {
        "amount_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Usd"
        },
        "upper_bound_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound Usd"
        },
        "evidence": {
          "$ref": "#/$defs/MeasurementEvidence"
        }
      },
      "title": "CashEstimate",
      "type": "object"
    },
    "CashEvidence": {
      "additionalProperties": false,
      "properties": {
        "charge_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Charge Id",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/CashClassification",
          "default": "unavailable"
        },
        "evidence": {
          "$ref": "#/$defs/MeasurementEvidence"
        },
        "rate_snapshot_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Snapshot Id"
        },
        "billing_record_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Billing Record Id"
        },
        "usage_fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Fingerprint"
        },
        "applied_rate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Applied Rate Ids",
          "type": "array"
        },
        "applied_meter_quantities": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Applied Meter Quantities",
          "type": "object"
        }
      },
      "required": [
        "charge_id"
      ],
      "title": "CashEvidence",
      "type": "object"
    },
    "EstimateSource": {
      "enum": [
        "static",
        "historical",
        "blended",
        "quote",
        "observed"
      ],
      "title": "EstimateSource",
      "type": "string"
    },
    "EstimateUncertainty": {
      "additionalProperties": false,
      "description": "Empirical bounds from one exact evidence cohort; never authorization.",
      "properties": {
        "profile": {
          "const": "aeep-estimate-uncertainty-v1",
          "default": "aeep-estimate-uncertainty-v1",
          "title": "Profile",
          "type": "string"
        },
        "method": {
          "const": "empirical-nearest-rank-wilson-v1",
          "default": "empirical-nearest-rank-wilson-v1",
          "title": "Method",
          "type": "string"
        },
        "sample_size": {
          "minimum": 5,
          "title": "Sample Size",
          "type": "integer"
        },
        "cohort_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Cohort Digest",
          "type": "string"
        },
        "resources_p50": {
          "$ref": "#/$defs/ResourceVector"
        },
        "resources_p95": {
          "$ref": "#/$defs/ResourceVector"
        },
        "cash_p95_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Observed p95 only; never a payment authorization maximum.",
          "title": "Cash P95 Usd"
        },
        "success_lower_bound": {
          "maximum": 1,
          "minimum": 0,
          "title": "Success Lower Bound",
          "type": "number"
        },
        "quality_sample_size": {
          "default": 0,
          "minimum": 0,
          "title": "Quality Sample Size",
          "type": "integer"
        },
        "quality_lower_bound": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Lower Bound"
        }
      },
      "required": [
        "sample_size",
        "cohort_digest",
        "resources_p50",
        "resources_p95",
        "success_lower_bound"
      ],
      "title": "EstimateUncertainty",
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "billing_record",
        "local_meter",
        "priced_measured_billable_usage",
        "confirmed_no_incremental_charge",
        "provider_report",
        "pinned_rate_table",
        "operator_report",
        "static_estimate",
        "legacy_unspecified",
        "unavailable"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "complete",
        "partial",
        "conflict",
        "unavailable"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "ExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "title": "Receipt Id",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "executor_id": {
          "title": "Executor Id",
          "type": "string"
        },
        "executor_kind": {
          "$ref": "#/$defs/ExecutorKind"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "estimated": {
          "$ref": "#/$defs/RouteEstimate"
        },
        "executor_fingerprint": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executor Fingerprint"
        },
        "cohort_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cohort Digest"
        },
        "action_features": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionFeatures"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_resources": {
          "$ref": "#/$defs/ResourceVector"
        },
        "accounting": {
          "$ref": "#/$defs/ResourceAccounting"
        },
        "cache_affinity": {
          "anyOf": [
            {
              "$ref": "#/$defs/CacheAffinityReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Id"
        },
        "transport_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Success"
        },
        "execution_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Success"
        },
        "schema_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Valid"
        },
        "task_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Valid"
        },
        "quality_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Score"
        },
        "validation_results": {
          "items": {
            "$ref": "#/$defs/ValidationResult"
          },
          "title": "Validation Results",
          "type": "array"
        },
        "output_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Valid"
        },
        "error_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "decision_id",
        "action_id",
        "capability",
        "executor_id",
        "executor_kind",
        "status",
        "estimated"
      ],
      "title": "ExecutionReceipt",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "success",
        "failed",
        "timeout",
        "rejected",
        "host_selected",
        "delegated",
        "unknown"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "ExecutorKind": {
      "enum": [
        "command",
        "python",
        "http",
        "mcp",
        "host",
        "delegate"
      ],
      "title": "ExecutorKind",
      "type": "string"
    },
    "MeasurementEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unavailable"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource",
          "default": "unavailable"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "untrusted"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "source_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[A-Fa-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        }
      },
      "title": "MeasurementEvidence",
      "type": "object"
    },
    "ModelAccessChannel": {
      "enum": [
        "api",
        "subscription",
        "purchased_credit",
        "mixed",
        "unknown"
      ],
      "title": "ModelAccessChannel",
      "type": "string"
    },
    "ModelTokenUsage": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "access_channel": {
          "$ref": "#/$defs/ModelAccessChannel",
          "default": "unknown"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "cache_write_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Write Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Output Tokens",
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/$defs/MeasurementEvidence"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "ModelTokenUsage",
      "type": "object"
    },
    "PolicyValuation": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "resource_pool": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Pool"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "explanation": {
          "default": "",
          "maxLength": 1000,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "policy_id"
      ],
      "title": "PolicyValuation",
      "type": "object"
    },
    "ResourceAccounting": {
      "additionalProperties": false,
      "properties": {
        "cash": {
          "$ref": "#/$defs/CashAccounting"
        },
        "subscription_usage": {
          "items": {
            "$ref": "#/$defs/SubscriptionUsage"
          },
          "title": "Subscription Usage",
          "type": "array"
        },
        "model_usage": {
          "items": {
            "$ref": "#/$defs/ModelTokenUsage"
          },
          "title": "Model Usage",
          "type": "array"
        },
        "tool_footprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolFootprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ResourceAccounting",
      "type": "object"
    },
    "ResourceVector": {
      "additionalProperties": false,
      "description": "Raw resource dimensions for one attempt.\n\n`memory_mb_seconds` is the integral of route-attributable resident memory\nover time. `peak_memory_mb` is retained separately because it is useful as a\nhard capacity constraint rather than only a consumable-resource signal.",
      "properties": {
        "monetary_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Monetary Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cpu_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cpu Ms",
          "type": "number"
        },
        "memory_mb_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Memory Mb Seconds",
          "type": "number"
        },
        "peak_memory_mb": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Peak Memory Mb",
          "type": "number"
        },
        "gpu_ms": {
          "default": 0.0,
