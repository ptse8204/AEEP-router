{
  "$defs": {
    "CurrencyAmount": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "CurrencyAmount",
      "type": "object"
    },
    "SignatureAlgorithm": {
      "enum": [
        "hmac-sha256",
        "ed25519"
      ],
      "title": "SignatureAlgorithm",
      "type": "string"
    },
    "SignatureEnvelopeV2": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/SignatureAlgorithm"
        },
        "key_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Key Id",
          "type": "string"
        },
        "value": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Value",
          "type": "string"
        },
        "canonicalization_version": {
          "default": "rfc8785-jcs-v1",
          "enum": [
            "aeep-canonical-json-v1",
            "rfc8785-jcs-v1"
          ],
          "title": "Canonicalization Version",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "title": "SignatureEnvelopeV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.5",
      "enum": [
        "0.4",
        "0.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "aggregate_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Aggregate Id",
      "type": "string"
    },
    "capability": {
      "maxLength": 200,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9_.-]*@[0-9]+(?:\\.[0-9]+){0,2}$",
      "title": "Capability",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Provider Id",
      "type": "string"
    },
    "executor_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Executor Id",
      "type": "string"
    },
    "executor_fingerprint": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Executor Fingerprint",
      "type": "string"
    },
    "region": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Region"
    },
    "account_tier": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Tier"
    },
    "input_bucket": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Input Bucket",
      "type": "string"
    },
    "sample_size": {
      "minimum": 1,
      "title": "Sample Size",
      "type": "integer"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "actual_cost_p50": {
      "anyOf": [
        {
          "$ref": "#/$defs/CurrencyAmount"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "actual_cost_p95": {
      "anyOf": [
        {
          "$ref": "#/$defs/CurrencyAmount"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latency_ms_p50": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms P50"
    },
    "latency_ms_p95": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms P95"
    },
    "valid_success_rate": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Success Rate"
    },
    "valid_success_lower_bound": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Success Lower Bound"
    },
    "settlement_verified_fraction": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "title": "Settlement Verified Fraction",
      "type": "string"
    },
    "billing_reconciled_fraction": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "title": "Billing Reconciled Fraction",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelopeV2"
    }
  },
  "required": [
    "aggregate_id",
    "capability",
    "provider_id",
    "executor_id",
    "executor_fingerprint",
    "input_bucket",
    "sample_size",
    "window_start",
    "window_end",
    "settlement_verified_fraction",
    "billing_reconciled_fraction",
    "generated_at",
    "expires_at",
    "signature"
  ],
  "title": "MarketAggregate",
  "type": "object"
}
