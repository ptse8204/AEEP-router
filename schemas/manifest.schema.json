{
  "$defs": {
    "ActionConstraints": {
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_latency_ms": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Latency Ms"
        },
        "max_cpu_ms": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cpu Ms"
        },
        "max_memory_mb_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Memory Mb Seconds"
        },
        "max_peak_memory_mb": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Peak Memory Mb"
        },
        "max_gpu_ms": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Gpu Ms"
        },
        "max_network_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Network Bytes"
        },
        "max_context_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Context Tokens"
        },
        "min_success_probability": {
          "default": 0.7,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Success Probability",
          "type": "number"
        },
        "min_quality_score": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Quality Score",
          "type": "number"
        },
        "max_risk_score": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Risk Score",
          "type": "number"
        },
        "max_side_effect": {
          "$ref": "#/$defs/SideEffect",
          "default": "read"
        },
        "allow_network": {
          "default": true,
          "title": "Allow Network",
          "type": "boolean"
        },
        "require_local": {
          "default": false,
          "title": "Require Local",
          "type": "boolean"
        },
        "allowed_executor_kinds": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ExecutorKind"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Executor Kinds"
        },
        "allowed_executor_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Executor Ids"
        },
        "denied_executor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Denied Executor Ids",
          "type": "array"
        },
        "allowed_data_residency": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Data Residency"
        }
      },
      "title": "ActionConstraints",
      "type": "object"
    },
    "AgentBudget": {
      "additionalProperties": false,
      "properties": {
        "budget_id": {
          "default": "default",
          "title": "Budget Id",
          "type": "string"
        },
        "daily_marketplace_limit_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Daily Marketplace Limit Usd",
          "type": "number"
        },
        "max_per_action_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Max Per Action Usd",
          "type": "number"
        },
        "prepaid_balance_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Prepaid Balance Usd",
          "type": "number"
        },
        "authorization": {
          "$ref": "#/$defs/AuthorizationPolicy"
        }
      },
      "title": "AgentBudget",
      "type": "object"
    },
    "AuthorizationPolicy": {
      "additionalProperties": false,
      "properties": {
        "auto_approve_under_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Auto Approve Under Usd",
          "type": "number"
        },
        "financial_actions_require_human": {
          "default": true,
          "title": "Financial Actions Require Human",
          "type": "boolean"
        },
        "preserve_subscriptions": {
          "items": {
            "type": "string"
          },
          "title": "Preserve Subscriptions",
          "type": "array"
        },
        "prefer_local_within_percent": {
          "default": 0.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Prefer Local Within Percent",
          "type": "number"
        }
      },
      "title": "AuthorizationPolicy",
      "type": "object"
    },
    "CapabilityDefinition": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Namespace",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "1",
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$",
          "title": "Version",
          "type": "string"
        },
        "authority": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Domain, URI, or organization responsible for the canonical contract.",
          "title": "Authority"
        },
        "owner": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "deprecated"
          ],
          "title": "Status",
          "type": "string"
        },
        "replaced_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaced By"
        },
        "compatible_versions": {
          "items": {
            "type": "string"
          },
          "title": "Compatible Versions",
          "type": "array"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect",
          "default": "read"
        }
      },
      "required": [
        "namespace",
        "name",
        "description"
      ],
      "title": "CapabilityDefinition",
      "type": "object"
    },
    "CashEstimate": {
      "additionalProperties": false,
      "properties": {
        "amount_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Usd"
        },
        "upper_bound_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound Usd"
        },
        "evidence": {
          "$ref": "#/$defs/MeasurementEvidence"
        }
      },
      "title": "CashEstimate",
      "type": "object"
    },
    "EstimateSource": {
      "enum": [
        "static",
        "historical",
        "blended",
        "quote",
        "observed"
      ],
      "title": "EstimateSource",
      "type": "string"
    },
    "EvidenceSource": {
      "enum": [
        "billing_record",
        "local_meter",
        "priced_measured_billable_usage",
        "confirmed_no_incremental_charge",
        "provider_report",
        "pinned_rate_table",
        "operator_report",
        "static_estimate",
        "legacy_unspecified",
        "unavailable"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "complete",
        "partial",
        "conflict",
        "unavailable"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "ExecutorKind": {
      "enum": [
        "command",
        "python",
        "http",
        "mcp",
        "host",
        "delegate"
      ],
      "title": "ExecutorKind",
      "type": "string"
    },
    "ExecutorSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "capability": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ExecutorKind"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "estimate": {
          "$ref": "#/$defs/RouteEstimate"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect",
          "default": "read"
        },
        "locality": {
          "$ref": "#/$defs/Locality",
          "default": "local"
        },
        "requires_network": {
          "default": false,
          "title": "Requires Network",
          "type": "boolean"
        },
        "data_residency": {
          "items": {
            "type": "string"
          },
          "title": "Data Residency",
          "type": "array"
        },
        "idempotent": {
          "default": true,
          "title": "Idempotent",
          "type": "boolean"
        },
        "safe_to_auto_execute": {
          "default": true,
          "title": "Safe To Auto Execute",
          "type": "boolean"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "resource_pool": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Pool"
        },
        "provider_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "validators": {
          "items": {
            "$ref": "#/$defs/ValidationSpec"
          },
          "title": "Validators",
          "type": "array"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "id",
        "capability",
        "kind",
        "description"
      ],
      "title": "ExecutorSpec",
      "type": "object"
    },
    "FallbackConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "retry_timeouts": {
          "default": true,
          "title": "Retry Timeouts",
          "type": "boolean"
        },
        "retry_validation_failures": {
          "default": true,
          "title": "Retry Validation Failures",
          "type": "boolean"
        },
        "allow_non_idempotent": {
          "default": false,
          "title": "Allow Non Idempotent",
          "type": "boolean"
        }
      },
      "title": "FallbackConfig",
      "type": "object"
    },
    "Locality": {
      "enum": [
        "in_process",
        "local",
        "lan",
        "internet"
      ],
      "title": "Locality",
      "type": "string"
    },
    "MeasurementEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unavailable"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource",
          "default": "unavailable"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "untrusted"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "source_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[A-Fa-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        }
      },
      "title": "MeasurementEvidence",
      "type": "object"
    },
    "MetricWeights": {
      "additionalProperties": false,
      "properties": {
        "monetary": {
          "default": 0.3,
          "minimum": 0.0,
          "title": "Monetary",
          "type": "number"
        },
        "latency": {
          "default": 0.25,
          "minimum": 0.0,
          "title": "Latency",
          "type": "number"
        },
        "compute": {
          "default": 0.25,
          "minimum": 0.0,
          "title": "Compute",
          "type": "number"
        },
        "subscription": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Subscription",
          "type": "number"
        },
        "reliability": {
          "default": 0.1,
          "minimum": 0.0,
          "title": "Reliability",
          "type": "number"
        },
        "quality": {
          "default": 0.05,
          "minimum": 0.0,
          "title": "Quality",
          "type": "number"
        },
        "risk": {
          "default": 0.05,
          "minimum": 0.0,
          "title": "Risk",
          "type": "number"
        }
      },
      "title": "MetricWeights",
      "type": "object"
    },
    "PersistenceConfig": {
      "additionalProperties": false,
      "description": "Local persistence controls.\n\nDecisions are useful for delegated outcome reporting and auditability, but\naction inputs and caller context can contain secrets or personal data. They\nare redacted from SQLite by default while the in-memory/returned decision\nremains complete.",
      "properties": {
        "store_action_inputs": {
          "default": false,
          "title": "Store Action Inputs",
          "type": "boolean"
        },
        "store_action_context": {
          "default": false,
          "title": "Store Action Context",
          "type": "boolean"
        }
      },
      "title": "PersistenceConfig",
      "type": "object"
    },
    "PolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "balanced",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "Balance expected cash cost, latency, and compute pressure.",
          "title": "Description",
          "type": "string"
        },
        "weights": {
          "$ref": "#/$defs/MetricWeights"
        },
        "references": {
          "$ref": "#/$defs/ReferenceScales"
        },
        "shadow_prices": {
          "$ref": "#/$defs/ShadowPrices"
        },
        "constraints": {
          "$ref": "#/$defs/ActionConstraints"
        },
        "fallback": {
          "$ref": "#/$defs/FallbackConfig"
        },
        "history_weight": {
          "default": 0.7,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "History Weight",
          "type": "number"
        },
        "history_prior_samples": {
          "default": 5,
          "maximum": 1000,
          "minimum": 1,
          "title": "History Prior Samples",
          "type": "integer"
        },
        "resource_scarcity_multiplier": {
          "default": 2.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Resource Scarcity Multiplier",
          "type": "number"
        },
        "subscription_scarcity_multiplier": {
          "default": 1.0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Subscription Scarcity Multiplier",
          "type": "number"
        },
        "subscription_rules": {
          "items": {
            "$ref": "#/$defs/SubscriptionPolicyRule"
          },
          "title": "Subscription Rules",
          "type": "array"
        },
        "uncertainty_penalty": {
          "default": 0.1,
          "description": "Added score burden at zero estimate confidence.",
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Uncertainty Penalty",
          "type": "number"
        },
        "prefer_local_bonus": {
          "default": 0.05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Prefer Local Bonus",
          "type": "number"
        },
        "deterministic_tie_break": {
          "default": true,
          "title": "Deterministic Tie Break",
          "type": "boolean"
        }
      },
      "title": "PolicyConfig",
      "type": "object"
    },
    "QuotaSource": {
      "enum": [
        "user",
        "host",
        "official_cli",
        "rate_limit",
        "heuristic",
        "observed"
      ],
      "title": "QuotaSource",
      "type": "string"
    },
    "QuotaState": {
      "description": "Private opportunity-cost signal for a non-transferable subscription.",
      "enum": [
        "abundant",
        "normal",
        "tight",
        "critical",
        "exhausted",
        "unknown"
      ],
      "title": "QuotaState",
      "type": "string"
    },
    "ReferenceScales": {
      "additionalProperties": false,
      "description": "A score of roughly one means one reference unit of burden.",
      "properties": {
        "monetary_usd": {
          "default": 0.05,
          "exclusiveMinimum": 0.0,
          "title": "Monetary Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 2000.0,
          "exclusiveMinimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cpu_ms": {
          "default": 1000.0,
          "exclusiveMinimum": 0.0,
          "title": "Cpu Ms",
          "type": "number"
        },
        "memory_mb_seconds": {
          "default": 256.0,
          "exclusiveMinimum": 0.0,
          "title": "Memory Mb Seconds",
          "type": "number"
        },
        "peak_memory_mb": {
          "default": 512.0,
          "exclusiveMinimum": 0.0,
          "title": "Peak Memory Mb",
          "type": "number"
        },
        "gpu_ms": {
          "default": 1000.0,
          "exclusiveMinimum": 0.0,
          "title": "Gpu Ms",
          "type": "number"
        },
        "network_bytes": {
          "default": 1000000,
          "exclusiveMinimum": 0,
          "title": "Network Bytes",
          "type": "integer"
        },
        "context_tokens": {
          "default": 8000,
          "exclusiveMinimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        }
      },
      "title": "ReferenceScales",
      "type": "object"
    },
    "RegistryConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "local",
            "remote"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "allowed_hosts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Hosts"
        },
        "allow_private_networks": {
          "default": false,
          "title": "Allow Private Networks",
          "type": "boolean"
        },
        "allow_insecure_http": {
          "default": false,
          "title": "Allow Insecure Http",
          "type": "boolean"
        },
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_response_bytes": {
          "default": 1000000,
          "maximum": 10000000,
          "minimum": 1024,
          "title": "Max Response Bytes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "RegistryConfig",
      "type": "object"
    },
    "ResourceVector": {
      "additionalProperties": false,
      "description": "Raw resource dimensions for one attempt.\n\n`memory_mb_seconds` is the integral of route-attributable resident memory\nover time. `peak_memory_mb` is retained separately because it is useful as a\nhard capacity constraint rather than only a consumable-resource signal.",
      "properties": {
        "monetary_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Monetary Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
