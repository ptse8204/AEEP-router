          "type": "integer"
        },
        "context_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "subscription_units": {
          "default": 0.0,
          "description": "Provider-local capacity units; not cash and not transferable.",
          "minimum": 0.0,
          "title": "Subscription Units",
          "type": "number"
        }
