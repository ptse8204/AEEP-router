        "memory_mb_second_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Memory Mb Second Usd",
          "type": "number"
        },
        "gpu_ms_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Gpu Ms Usd",
          "type": "number"
