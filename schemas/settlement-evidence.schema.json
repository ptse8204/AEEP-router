{
  "$defs": {
    "CurrencyAmount": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "CurrencyAmount",
      "type": "object"
    },
    "EconomicEvidenceLevel": {
      "enum": [
        "UNKNOWN",
        "STATIC_PRIOR",
        "PUBLISHED_OFFER",
        "SIGNED_QUOTE",
        "SIGNED_USAGE_STATEMENT",
        "PAYMENT_SETTLEMENT",
        "BILLING_RECONCILED",
        "OPERATOR_ATTESTED"
      ],
      "title": "EconomicEvidenceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.5",
      "enum": [
        "0.4",
        "0.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "charge_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Charge Id",
      "type": "string"
    },
    "evidence_level": {
      "$ref": "#/$defs/EconomicEvidenceLevel",
      "default": "UNKNOWN"
    },
    "usage_statement_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage Statement Id"
    },
    "evidence_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Digest"
    },
    "external_reference": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Reference"
    },
    "provider_calculated_amount": {
      "anyOf": [
        {
          "$ref": "#/$defs/CurrencyAmount"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "charge_id"
  ],
  "title": "SettlementEvidence",
  "type": "object"
}
