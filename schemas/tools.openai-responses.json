{
  "tools": [
    {
      "type": "function",
      "name": "aeep_list_capabilities",
      "description": "List semantic capabilities and their available CLI, Python, HTTP, MCP, or host executors before choosing an action.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "default": ""
          },
          "prefix": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "cursor": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "include_executors": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "aeep_route_action",
      "description": "Profile and rank feasible execution routes for an agent action without executing it. Returns estimates, hard-constraint rejections, score components, and the selected route.",
      "parameters": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "description": "Stable semantic action name, for example text.stats or github.issue.create."
          },
          "input": {
            "type": "object",
            "description": "JSON input passed to the selected executor.",
            "additionalProperties": true
          },
          "policy": {
            "type": "string",
            "default": "balanced",
            "description": "Routing policy name: balanced, cheapest, fastest, resource_saver, reliable, or a manifest policy."
          },
          "constraints": {
            "type": "object",
            "description": "Optional hard budget, latency, compute, privacy, and safety constraints.",
            "additionalProperties": true
          },
          "context": {
            "type": "object",
            "description": "Optional current quota/capacity, state-locality, sensitivity, and trace context.",
            "additionalProperties": true
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 256,
            "description": "Stable key that prevents duplicate execution of the same action."
          },
          "detail": {
            "type": "string",
            "enum": [
              "compact",
              "full"
            ],
            "default": "compact"
          }
        },
        "required": [
          "capability",
          "input"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "aeep_execute_action",
      "description": "Route and execute an agent action within the operator-configured server approval ceiling. AEEP applies hard constraints first, then balances cost, latency, compute pressure, reliability, quality, and risk. Returns execution receipts.",
      "parameters": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "description": "Stable semantic action name, for example text.stats or github.issue.create."
          },
          "input": {
            "type": "object",
            "description": "JSON input passed to the selected executor.",
            "additionalProperties": true
          },
          "policy": {
            "type": "string",
            "default": "balanced",
            "description": "Routing policy name: balanced, cheapest, fastest, resource_saver, reliable, or a manifest policy."
          },
          "constraints": {
            "type": "object",
            "description": "Optional hard budget, latency, compute, privacy, and safety constraints.",
            "additionalProperties": true
          },
          "context": {
            "type": "object",
            "description": "Optional current quota/capacity, state-locality, sensitivity, and trace context.",
            "additionalProperties": true
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 256,
            "description": "Stable key that prevents duplicate execution of the same action."
          },
          "dry_run": {
            "type": "boolean",
            "default": false,
            "description": "Return the route decision without invoking the executor."
          },
          "detail": {
            "type": "string",
            "enum": [
              "compact",
              "full"
            ],
            "default": "compact"
          }
        },
        "required": [
          "capability",
          "input"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "aeep_record_outcome",
      "description": "Report the observed result of a browser, computer-use, model, or other host-delegated route so future decisions learn its actual cost, latency, compute use, and reliability.",
      "parameters": {
        "$defs": {
          "ExecutionStatus": {
            "enum": [
              "success",
              "failed",
              "timeout",
              "rejected"
            ],
            "title": "ExecutionStatus",
            "type": "string"
          },
          "QuotaSource": {
            "enum": [
              "user",
              "host",
              "official_cli",
              "rate_limit",
              "heuristic",
              "observed"
            ],
            "title": "QuotaSource",
            "type": "string"
          },
          "QuotaState": {
            "description": "Private opportunity-cost signal for a non-transferable subscription.",
            "enum": [
              "abundant",
              "normal",
              "tight",
              "critical",
              "exhausted",
              "unknown"
            ],
            "title": "QuotaState",
            "type": "string"
          },
          "ResourceVector": {
            "additionalProperties": false,
            "description": "Raw resource dimensions for one attempt.\n\n`memory_mb_seconds` is the integral of route-attributable resident memory\nover time. `peak_memory_mb` is retained separately because it is useful as a\nhard capacity constraint rather than only a consumable-resource signal.",
            "properties": {
              "monetary_usd": {
                "default": 0.0,
                "minimum": 0.0,
                "title": "Monetary Usd",
                "type": "number"
              },
              "latency_ms": {
                "default": 0.0,
                "minimum": 0.0,
                "title": "Latency Ms",
                "type": "number"
              },
              "cpu_ms": {
                "default": 0.0,
                "minimum": 0.0,
                "title": "Cpu Ms",
                "type": "number"
              },
              "memory_mb_seconds": {
                "default": 0.0,
                "minimum": 0.0,
                "title": "Memory Mb Seconds",
                "type": "number"
              },
              "peak_memory_mb": {
                "default": 0.0,
                "minimum": 0.0,
                "title": "Peak Memory Mb",
                "type": "number"
              },
              "gpu_ms": {
                "default": 0.0,
                "minimum": 0.0,
                "title": "Gpu Ms",
                "type": "number"
              },
              "network_bytes": {
                "default": 0,
                "minimum": 0,
                "title": "Network Bytes",
                "type": "integer"
              },
              "context_tokens": {
                "default": 0,
                "minimum": 0,
                "title": "Context Tokens",
                "type": "integer"
              },
              "input_tokens": {
                "default": 0,
                "minimum": 0,
                "title": "Input Tokens",
                "type": "integer"
              },
              "cached_input_tokens": {
                "default": 0,
                "minimum": 0,
                "title": "Cached Input Tokens",
                "type": "integer"
              },
              "output_tokens": {
                "default": 0,
                "minimum": 0,
                "title": "Output Tokens",
                "type": "integer"
              },
              "subscription_units": {
                "default": 0.0,
                "description": "Provider-local capacity units; not cash and not transferable.",
                "minimum": 0.0,
                "title": "Subscription Units",
                "type": "number"
              }
            },
            "title": "ResourceVector",
            "type": "object"
          },
          "SubscriptionQuota": {
            "additionalProperties": false,
            "properties": {
              "state": {
                "$ref": "#/$defs/QuotaState",
                "default": "unknown"
              },
              "reset_at": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Reset At"
              },
              "confidence": {
                "default": 0.5,
                "maximum": 1.0,
                "minimum": 0.0,
                "title": "Confidence",
                "type": "number"
              },
              "source": {
                "$ref": "#/$defs/QuotaSource",
                "default": "user"
              },
              "unit": {
                "default": "provider_unit",
                "maxLength": 100,
                "minLength": 1,
                "title": "Unit",
                "type": "string"
              },
              "allowance_units": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Allowance Units"
              },
              "remaining_units": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Remaining Units"
              }
            },
            "title": "SubscriptionQuota",
            "type": "object"
          },
          "TrustLevel": {
            "enum": [
              "untrusted",
              "self_asserted",
              "observed",
              "verified",
              "attested"
            ],
            "title": "TrustLevel",
            "type": "string"
          },
          "ValidationKind": {
            "enum": [
              "schema",
              "exact_match",
              "range",
              "state_transition",
              "callback",
              "downstream",
              "llm",
              "human"
            ],
            "title": "ValidationKind",
            "type": "string"
          },
          "ValidationResult": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "$ref": "#/$defs/ValidationKind"
              },
              "valid": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Valid"
              },
              "quality_score": {
                "anyOf": [
                  {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Quality Score"
              },
              "detail": {
                "default": "",
                "maxLength": 4096,
                "title": "Detail",
                "type": "string"
              },
              "trust": {
                "$ref": "#/$defs/TrustLevel",
                "default": "observed"
              }
            },
            "required": [
              "kind"
            ],
            "title": "ValidationResult",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "decision_id": {
            "title": "Decision Id",
            "type": "string"
          },
          "executor_id": {
            "title": "Executor Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/ExecutionStatus"
          },
          "actual_resources": {
            "$ref": "#/$defs/ResourceVector"
          },
          "output_valid": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Output Valid"
          },
          "task_valid": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Task Valid"
          },
          "quality_score": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quality Score"
          },
          "validation_results": {
            "items": {
              "$ref": "#/$defs/ValidationResult"
            },
            "title": "Validation Results",
            "type": "array"
          },
          "quota_observation": {
            "anyOf": [
              {
                "$ref": "#/$defs/SubscriptionQuota"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "error_message": {
            "anyOf": [
              {
                "maxLength": 16384,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Message"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ended At"
          }
        },
        "required": [
          "decision_id",
          "executor_id",
          "status"
        ],
        "title": "ExternalOutcomeReport",
        "type": "object"
      }
    },
    {
      "type": "function",
      "name": "aeep_request_quotes",
      "description": "Read expiring legacy compatibility estimates derived from local static route data. This operation is non-binding and performs no remote quote network calls.",
      "parameters": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "description": "Stable semantic action name, for example text.stats or github.issue.create."
          },
          "input": {
            "type": "object",
            "description": "JSON input passed to the selected executor.",
            "additionalProperties": true
          },
          "policy": {
            "type": "string",
            "default": "balanced",
            "description": "Routing policy name: balanced, cheapest, fastest, resource_saver, reliable, or a manifest policy."
          },
          "constraints": {
            "type": "object",
            "description": "Optional hard budget, latency, compute, privacy, and safety constraints.",
            "additionalProperties": true
          },
          "context": {
            "type": "object",
            "description": "Optional current quota/capacity, state-locality, sensitivity, and trace context.",
            "additionalProperties": true
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 256,
            "description": "Stable key that prevents duplicate execution of the same action."
          },
          "executor_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "capability",
          "input"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "aeep_get_metrics",
      "description": "Read private aggregate savings, substitutions, resource use, and subscription capacity conserved from local AEEP history.",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 10000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "aeep_show_prepared_decision",
      "description": "Read a persisted, sanitized prepared-route decision. This never prepares or executes a route and never contacts a quote provider.",
      "parameters": {
        "type": "object",
        "properties": {
          "prepared_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "prepared_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "aeep_show_quote",
      "description": "Read a persisted, sanitized bounded quote, including its evidence level, maximum amount, expiry, and signature metadata.",
      "parameters": {
        "type": "object",
        "properties": {
          "quote_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "quote_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "aeep_show_settlement",
      "description": "Read a persisted, sanitized settlement receipt, including reserved, captured, and released amounts and its evidence level.",
      "parameters": {
        "type": "object",
        "properties": {
          "settlement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "settlement_id"
        ],
        "additionalProperties": false
      }
    }
  ]
}
