{
  "$defs": {
    "CapacityEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "source",
        "source_digest"
      ],
      "title": "CapacityEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "window_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Window Id",
      "type": "string"
    },
    "unit": {
      "default": "provider_unit",
      "maxLength": 100,
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    },
    "used_percent": {
      "anyOf": [
        {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Used Percent"
    },
    "allowance": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowance"
    },
    "remaining": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remaining"
    },
    "reset_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reset At"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "hard_limit": {
      "default": true,
      "title": "Hard Limit",
      "type": "boolean"
    },
    "exhausted": {
      "default": false,
      "title": "Exhausted",
      "type": "boolean"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CapacityEvidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "window_id"
  ],
  "title": "CapacityWindow",
  "type": "object"
}
