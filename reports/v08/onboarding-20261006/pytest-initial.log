                return Record(
                    {
                        "quote_id": quote_id,
                        "maximum_amount": {"amount": "0.0050", "currency": "USD"},
                        "evidence_level": "SIGNED_QUOTE",
                        "authorization": "must-not-leak",
                    }
                )
    
            def get_settlement_receipt(self, settlement_id):
                return Record(
                    {
