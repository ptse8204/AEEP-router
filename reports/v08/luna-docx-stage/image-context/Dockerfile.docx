# Matched DOCX pair. Both roles inherit the same pin-1592 plain control image
# and receive the exact same Python package layer; treatment adds only SKILL.md.
FROM aeep-sol61-successor-control@sha256:85fa95d74a3124ea35015e747645fe85be03277bee04598675928a822987532d AS common
USER root
RUN python3 -c "import sys; assert sys.version_info[:2] == (3, 13), sys.version"
COPY wheels/ /tmp/wheels/
COPY requirements-docx.lock /tmp/requirements-docx.lock
RUN python3 -m pip install --no-index --find-links=/tmp/wheels --require-hashes -r /tmp/requirements-docx.lock && rm -rf /tmp/wheels /tmp/requirements-docx.lock
USER 65534:65534

FROM common AS control

FROM common AS treatment
USER root
COPY docx/SKILL.md /opt/dependencies/plugin/skills/docx/SKILL.md
RUN mkdir -p /etc/codex/skills && ln -s /opt/dependencies/plugin/skills/docx /etc/codex/skills/docx
USER 65534:65534
