(version 1)
(allow default)
(deny network-outbound (remote ip "*:*"))
(deny network-inbound (local ip "*:*"))
(allow network-outbound (remote ip "localhost:*"))
(allow network-inbound (local ip "localhost:39068"))
(deny file-write*)
(deny file-read* (subpath "/Users"))
