(version 1)
(allow default)
(deny network*)
(deny file-write*)
(allow file-write* (subpath @HOME@) (subpath @TMP@))
(allow file-write* (literal "/dev/null"))
(deny file-read* (subpath "/Users"))
(allow file-read* (subpath @ROOT@))
(deny file-read* (subpath @AEEP@) (subpath @GIT@) (subpath @CODEX@))
